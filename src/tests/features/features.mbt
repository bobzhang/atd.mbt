  x : Json,
  path : @atd_runtime.Path,
) -> Patch raise @atd_runtime.JsonError {
  let o = @atd_runtime.read_object(x, path, "patch")
  Patch::{
    x: @atd_runtime.read_optional_field(
      o,
      "x",
      @atd_runtime.read_nullable(@atd_runtime.read_int),
      path,
      keep_nulls=true,
    ),
    y: @atd_runtime.read_optional_field(
      o,
      "y",
      @atd_runtime.read_nullable(@atd_runtime.read_int),
      path,
      keep_nulls=true,
    ),
    z: @atd_runtime.read_optional_field(
      o,
      "z",
      @atd_runtime.read_nullable(@atd_runtime.read_int),
      path,
      keep_nulls=true,
    ),
  }
}

