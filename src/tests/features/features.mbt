  match x {
    Fruit::Apple => Json::string("Apple")
    Fruit::Banana => Json::string("Banana")
    Fruit::Other(v0) =>
      Json::array([Json::string("Other"), @atd_runtime.write_string(v0)])
  }
}

///|
