    Array([String("Node"), v]) => {
      let p = path.index(1)
      let a = @atd_runtime.read_tuple(v, p, 2)
      Tree::Node(read_tree(a[0], p.index(0)), read_tree(a[1], p.index(1)))
    }
    _ => @atd_runtime.bad_json("tree", x, path)
  }
