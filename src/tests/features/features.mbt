  x : Int??
  y : Int??
  z : Int??
} derive(Eq, Debug)

///|
/// Create a value of type `Patch`.
pub fn Patch::new(x? : Int?, y? : Int?, z? : Int?) -> Patch {
  Patch::{ x, y, z, }
}

///|
pub fn write_patch(x : Patch) -> Json {
  let o : Map[String, Json] = Map([])
  match x.x {
    Some(v) => o["x"] = @atd_runtime.write_nullable(@atd_runtime.write_int)(v)
    None => ()
  }
  match x.y {
    Some(v) => o["y"] = @atd_runtime.write_nullable(@atd_runtime.write_int)(v)
    None => ()
  }
  match x.z {
    Some(v) => o["z"] = @atd_runtime.write_nullable(@atd_runtime.write_int)(v)
    None => ()
  }
  Json::object(o)
}

///|
