///|
pub(all) struct Tuples {
  unit_tuple : Unit
  single : Int
  pair : (Int, String)
  annotated : (Int, Double)
} derive(Eq, Debug)

///|
/// Create a value of type `Tuples`.
pub fn Tuples::new(
  unit_tuple~ : Unit,
  single~ : Int,
  pair~ : (Int, String),
  annotated~ : (Int, Double),
) -> Tuples {
  Tuples::{ unit_tuple, single, pair, annotated, }
}

///|
pub fn write_tuples(x : Tuples) -> Json {
  let o : Map[String, Json] = Map([])
  o["unit_tuple"] = ((_ : Unit) => Json::array([]))(x.unit_tuple)
  o["single"] = (x => Json::array([@atd_runtime.write_int(x)]))(x.single)
  o["pair"] = Json::array([
    @atd_runtime.write_int(x.pair.0),
    @atd_runtime.write_string(x.pair.1),
  ])
  o["annotated"] = Json::array([
    @atd_runtime.write_int(x.annotated.0),
    @atd_runtime.write_float(x.annotated.1),
  ])
  Json::object(o)
}

///|
pub fn read_tuples(
  x : Json,
  path : @atd_runtime.Path,
) -> Tuples raise @atd_runtime.JsonError {
  let o = @atd_runtime.read_object(x, path, "tuples")
  Tuples::{
    unit_tuple: @atd_runtime.read_required_field(
      o,
      "tuples",
      "unit_tuple",
      (x, path) => ignore(@atd_runtime.read_tuple(x, path, 0)),
      path,
    ),
    single: @atd_runtime.read_required_field(
      o,
      "tuples",
      "single",
      (x, path) => {
        let a = @atd_runtime.read_tuple(x, path, 1)
        @atd_runtime.read_int(a[0], path.index(0))
      },
      path,
    ),
    pair: @atd_runtime.read_required_field(
      o,
      "tuples",
      "pair",
      (x, path) => {
        let a = @atd_runtime.read_tuple(x, path, 2)
        (
          @atd_runtime.read_int(a[0], path.index(0)),
          @atd_runtime.read_string(a[1], path.index(1)),
        )
      },
      path,
    ),
    annotated: @atd_runtime.read_required_field(
      o,
      "tuples",
      "annotated",
      (x, path) => {
        let a = @atd_runtime.read_tuple(x, path, 2)
        (
          @atd_runtime.read_int(a[0], path.index(0)),
          @atd_runtime.read_float(a[1], path.index(1)),
        )
      },
      path,
    ),
  }
}

///|
/// Convert a JSON value into a value of type `Tuples`.
pub fn tuples_of_json(x : Json) -> Tuples raise @atd_runtime.JsonError {
  read_tuples(x, @atd_runtime.Path::Root)
}

///|
/// Parse a JSON string into a value of type `Tuples`.
pub fn tuples_of_string(s : StringView) -> Tuples raise @atd_runtime.JsonError {
  read_tuples(@atd_runtime.parse(s), @atd_runtime.Path::Root)
}

///|
/// Serialize a value of type `Tuples` to JSON, compactly or with the
/// given indentation.
pub fn string_of_tuples(x : Tuples, indent? : Int = 0) -> String {
  @atd_runtime.stringify(write_tuples(x), indent~)
}

