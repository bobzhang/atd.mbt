pub(all) struct Defaults {
  b : Bool
  i : Int
  f : Double
  s : String
  l : Array[String]
  o : Int?
  u : Unit
  j : Json
  alias_default : StringList
  custom : Array[Int]
  custom_enum : Color
} derive(Eq, Debug)

///|
/// Create a value of type `Defaults`.
pub fn Defaults::new(
  b? : Bool = false,
  i? : Int = 0,
  f? : Double = 0.0,
  s? : String = "",
  l? : Array[String] = [],
  o? : Int? = None,
  u? : Unit = (),
  j? : Json = Json::null(),
  alias_default? : StringList = [],
  custom? : Array[Int] = [1, 2, 3],
  custom_enum? : Color = Color::Red,
) -> Defaults {
  Defaults::{ b, i, f, s, l, o, u, j, alias_default, custom, custom_enum, }
}

///|
pub fn write_defaults(x : Defaults) -> Json {
  let o : Map[String, Json] = Map([])
  o["b"] = @atd_runtime.write_bool(x.b)
  o["i"] = @atd_runtime.write_int(x.i)
  o["f"] = @atd_runtime.write_float(x.f)
  o["s"] = @atd_runtime.write_string(x.s)
  o["l"] = @atd_runtime.write_list(@atd_runtime.write_string)(x.l)
  o["o"] = @atd_runtime.write_nullable(@atd_runtime.write_int)(x.o)
  o["u"] = @atd_runtime.write_unit(x.u)
  o["j"] = @atd_runtime.write_json(x.j)
  o["alias_default"] = write_string_list(x.alias_default)
  o["custom"] = @atd_runtime.write_list(@atd_runtime.write_int)(x.custom)
  o["custom_enum"] = write_color(x.custom_enum)
  Json::object(o)
}

///|
pub fn read_defaults(
  x : Json,
  path : @atd_runtime.Path,
) -> Defaults raise @atd_runtime.JsonError {
  let o = @atd_runtime.read_object(x, path, "defaults")
  Defaults::{
    b: match @atd_runtime.get_field(o, "b") {
      Some(v) => @atd_runtime.read_bool(v, path.key("b"))
      None => false
    },
    i: match @atd_runtime.get_field(o, "i") {
      Some(v) => @atd_runtime.read_int(v, path.key("i"))
      None => 0
    },
    f: match @atd_runtime.get_field(o, "f") {
      Some(v) => @atd_runtime.read_float(v, path.key("f"))
      None => 0.0
    },
    s: match @atd_runtime.get_field(o, "s") {
      Some(v) => @atd_runtime.read_string(v, path.key("s"))
      None => ""
    },
    l: match @atd_runtime.get_field(o, "l") {
      Some(v) =>
        @atd_runtime.read_list(@atd_runtime.read_string)(v, path.key("l"))
      None => []
    },
    o: match @atd_runtime.get_field(o, "o") {
      Some(v) =>
        @atd_runtime.read_nullable(@atd_runtime.read_int)(v, path.key("o"))
      None => None
    },
    u: match @atd_runtime.get_field(o, "u") {
      Some(v) => @atd_runtime.read_unit(v, path.key("u"))
      None => ()
    },
    j: match @atd_runtime.get_field(o, "j") {
      Some(v) => @atd_runtime.read_json(v, path.key("j"))
      None => Json::null()
    },
    alias_default: match @atd_runtime.get_field(o, "alias_default") {
      Some(v) => read_string_list(v, path.key("alias_default"))
      None => []
    },
    custom: match @atd_runtime.get_field(o, "custom") {
      Some(v) =>
        @atd_runtime.read_list(@atd_runtime.read_int)(v, path.key("custom"))
      None => [1, 2, 3]
    },
    custom_enum: match @atd_runtime.get_field(o, "custom_enum") {
      Some(v) => read_color(v, path.key("custom_enum"))
      None => Color::Red
    },
  }
}

