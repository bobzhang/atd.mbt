///|
/// A documented type.
///
/// Second paragraph with `code`.
///
/// ```text
/// preformatted
///   text
/// ```
pub(all) enum Documented {
  /// A documented case.
  Documented(Int)
  Undocumented
} derive(Eq, Debug)

///|
pub fn write_documented(x : Documented) -> Json {
  match x {
    Documented::Documented(v0) =>
      Json::array([Json::string("Documented"), @atd_runtime.write_int(v0)])
    Documented::Undocumented => Json::string("Undocumented")
  }
}

///|
pub fn read_documented(
  x : Json,
  path : @atd_runtime.Path,
) -> Documented raise @atd_runtime.JsonError {
  match x {
    String("Undocumented") => Documented::Undocumented
    Array([String("Documented"), v]) =>
      Documented::Documented(@atd_runtime.read_int(v, path.index(1)))
    _ => @atd_runtime.bad_json("documented", x, path)
  }
}

///|
/// Convert a JSON value into a value of type `Documented`.
pub fn documented_of_json(x : Json) -> Documented raise @atd_runtime.JsonError {
  read_documented(x, @atd_runtime.Path::Root)
}

///|
/// Parse a JSON string into a value of type `Documented`.
pub fn documented_of_string(
  s : StringView,
) -> Documented raise @atd_runtime.JsonError {
  read_documented(@atd_runtime.parse(s), @atd_runtime.Path::Root)
}

///|
/// Serialize a value of type `Documented` to JSON, compactly or with the
/// given indentation.
pub fn string_of_documented(x : Documented, indent? : Int = 0) -> String {
  @atd_runtime.stringify(write_documented(x), indent~)
}

///|
pub impl ToJson for Documented with fn to_json(self) {
  write_documented(self)
}

