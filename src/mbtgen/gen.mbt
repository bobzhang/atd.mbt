// Entry points of the MoonBit code generator.

///|
fn is_abstract(e : @atd.TypeExpr) -> Bool {
  unwrap(e) is Name(_, { name: { path: ["abstract"], }, args: [], .. }, _)
}

///|
/// MoonBit can't define a type alias in terms of itself, e.g.
/// `type t = t list` is not supported, unlike cycles going through a
/// record or a sum type.
fn check_recursive_aliases(
  defs : Array[@atd.TypeDef],
) -> Unit raise @atd.AtdError {
  let aliases : Map[String, @atd.TypeDef] = Map([])
  for d in defs {
    match unwrap(d.value) {
      Sum(_) | Record(_) => ()
      _ => aliases[d.name.to_string()] = d
    }
  }
  // depth-first search on the graph of aliases, iteratively
  // state: 1 = being visited, 2 = done
  let state : Map[String, Int] = Map([])
  for d in defs {
    let root = d.name.to_string()
    if !aliases.contains(root) || state.contains(root) {
      continue
    }
    let stack : Array[(String, Array[String], Int)] = []
    let deps = (name : String) => {
      aliases[name].value
      .extract_type_names()
      .map(n => n.to_string())
      .filter(n => aliases.contains(n))
    }
    state[root] = 1
    stack.push((root, deps(root), 0))
    while stack.last() is Some((name, succ, i)) {
      if i < succ.length() {
        stack[stack.length() - 1] = (name, succ, i + 1)
        let next = succ[i]
        match state.get(next) {
          Some(1) => {
            let d = aliases[next]
            @atd.error_at(
              d.loc,
              "not implemented in atdmbt: recursive type alias '\{next}'; use a record or a sum type to break the cycle",
            )
          }
          Some(_) => ()
          None => {
            state[next] = 1
            stack.push((next, deps(next), 0))
          }
        }
      } else {
        state[name] = 2
        ignore(stack.pop())
      }
    }
  }
}

///|
fn header(
  atd_filename : String,
  m : @atd.Module,
) -> Array[String] raise @atd.AtdError {
  let lines = [
    "// Generated by atdmbt from type definitions in '\{atd_filename}'.",
    "//",
    "// Type-safe translations from/to JSON.",
    "//",
    "// For each type 'foo', there are the following functions:",
    "// - 'write_foo': convert a 'Foo' value into a JSON value;",
    "// - 'read_foo': convert a JSON value into a 'Foo' value;",
    "// - 'foo_of_json', 'foo_of_string' and 'string_of_foo': conveniences.",
    "//",
    "// This code requires the package \"bobzhang/atd/runtime\", imported with",
    "// the alias 'atd_runtime' in moon.pkg:",
    "//",
    "//   import {",
    "//     \"bobzhang/atd/runtime\" @atd_runtime,",
  ]
  for i in m.imports {
    let alias_ = package_alias(i)
    lines.push("//     \"<module>/\{i.path.join("/")}\" @\{alias_},")
  }
  lines.push("//   }")
  let (loc, an) = m.head
  let doc = doc_comment(loc, an)
  if !doc.is_empty() {
    lines.push("//")
    for l in doc {
      // turn doc comments into ordinary comments
      lines.push("//" + l.view(start_offset=3).to_owned())
    }
  }
  lines.push("")
  lines
}

///|
/// Generate MoonBit code from an ATD module, which must have been loaded
/// with `inherit` statements expanded (see `generate`).
pub fn generate_module(
  m : @atd.Module,
  atd_filename~ : String,
) -> String raise @atd.AtdError {
  // Parametrized abstract types like `type 'a t = abstract` are
  // represented as raw JSON.
  let abstract_poly = m.type_defs
    .filter(d => !d.param.is_empty() && is_abstract(d.value))
    .map(d => d.name.to_string())
  let defs = @atd.expand_type_defs(m.type_defs, keep_builtins=true)
  let m : @atd.Module = { ..m, type_defs: defs, }.use_only_specific_variants()
  let defs = lift_inline_types(m.type_defs)
  check_recursive_aliases(defs)
  let local_module_names = []
  for i in m.imports {
    local_module_names.push(package_alias(i))
  }
  let env : Env = {
    type_names: @atd.UniqueNames::new(
      reserved_identifiers=[..mbt_reserved_type_names, ..local_module_names],
      reserved_prefixes=[],
      safe_prefix="",
    ),
    imports: @atd.load_imports(m.imports),
    defs: Map::from_array(defs.map(d => (d.name.to_string(), d))),
    abstract_poly,
    fun_bases: Map([]),
    used_funs: Map([]),
    hash_types: Map([]),
  }
  env.find_hash_types(defs)
  // Make sure that the types defined in the ATD file get the best names,
  // in the order of their definitions.
  for d in defs {
    ignore(env.type_name(d.name.to_string()))
  }
  for d in defs {
    ignore(env.fun_base(d.name.to_string()))
  }
  let out = header(atd_filename, m)
  for d in defs {
    if !d.param.is_empty() {
      not_implemented(d.loc, "parametrized type")
    }
    match unwrap(d.value) {
      Record(_, fields, an) => {
        env.gen_record(out, d, fields, an)
        env.gen_helpers(out, d, true)
      }
      Sum(_, variants, an) => {
        env.gen_sum(out, d, variants, an)
        env.gen_helpers(out, d, true)
      }
      e => {
        env.gen_alias(out, d, e)
        env.gen_helpers(out, d, false)
      }
    }
  }
  while out.last() is Some("") {
    ignore(out.pop())
  }
  out.join("\n") + "\n"
}

///|
/// Generate MoonBit code from the contents of an ATD file.
pub fn generate(
  src : BytesView,
  atd_filename~ : String,
  pos_fname? : String = atd_filename,
  on_warning? : (String) -> Unit = msg => eprintln(msg),
) -> String raise @atd.AtdError {
  let m = @atd.load_bytes(
    src,
    annot_schema~,
    inherit_fields=true,
    inherit_variants=true,
    pos_fname~,
    on_warning~,
  )
  generate_module(m, atd_filename~)
}

///|
/// Name of the MoonBit file generated for an ATD file, e.g. `foo.mbt` for
/// `path/to/Foo.atd`.
pub fn output_file_name(atd_path : String) -> String {
  let base = match atd_path.rev_find("/") {
    Some(i) => atd_path.view(start_offset=i + 1).to_owned()
    None => atd_path
  }
  let base = if base.has_suffix(".atd") {
    base.view(end_offset=base.length() - 4).to_owned()
  } else {
    base
  }
  base.to_lower() + ".mbt"
}

///|
/// Find the local types that are used, directly or not, in the keys of
/// maps (`(k * v) list <mbt repr="map">`), which must implement `Hash`.
fn Env::find_hash_types(
  self : Env,
  defs : Array[@atd.TypeDef],
) -> Unit raise @atd.AtdError {
  let todo : Array[String] = []
  for d in defs {
    d.value.fold((), (e, _) => {
      match e {
        List(loc, elt, an) =>
          match assoc_kind(loc, elt, an) {
            ArrayMap(key, _) =>
              for n in key.extract_type_names() {
                todo.push(n.to_string())
              }
            _ => ()
          }
        _ => ()
      }
    })
  }
  while todo.pop() is Some(name) {
    if self.hash_types.contains(name) {
      continue
    }
    match self.defs.get(name) {
      None => () // predefined or imported
      Some(d) => {
        self.hash_types[name] = ()
        for n in d.value.extract_type_names() {
          todo.push(n.to_string())
        }
      }
    }
  }
}
