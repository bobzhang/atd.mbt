///|
fn gen(src : String) -> String raise {
  @mbtgen.generate(@utf8.encode(src), atd_filename="test.atd", on_warning=_ => {
    ()
  })
}

///|
fn gen_error(src : String) -> String raise {
  try gen(src) catch {
    @atd.AtdError(msg) => msg
    e => raise e
  } noraise {
    _ => fail("expected an error")
  }
}

///|
test "errors" {
  inspect(
    gen_error("type t = t list"),
    content=(
      #|File "test.atd", line 1, characters 0-15:
      #|not implemented in atdmbt: recursive type alias 't'; use a record or a sum type to break the cycle
    ),
  )
  inspect(
    gen_error("type t = u option\ntype u = t list"),
    content=(
      #|File "test.atd", line 1, characters 0-17:
      #|not implemented in atdmbt: recursive type alias 't'; use a record or a sum type to break the cycle
    ),
  )
  inspect(
    gen_error("type t = { ~x : u }\ntype u = [ A ]"),
    content=(
      #|File "test.atd", line 1, characters 11-17:
      #|a default field value must be specified with <mbt default="...">
    ),
  )
  inspect(
    gen_error("type t = int shared"),
    content=(
      #|File "test.atd", line 1, characters 8-19:
      #|not implemented in atdmbt: shared
    ),
  )
  inspect(
    gen_error("type t = { ?x : int }"),
    content=(
      #|File "test.atd", line 1, characters 11-19:
      #|the type of optional field 'x' should be of the form 'xxx option'
    ),
  )
  inspect(
    gen_error("type t = (int * int) list <json repr=\"object\">"),
    content=(
      #|File "test.atd", line 1, characters 9-46:
      #|not a (string * _) list
    ),
  )
  inspect(
    gen_error("type t = int <mbt foo>"),
    content=(
      #|File "test.atd", line 1, characters 18-21:
      #|Invalid or misplaced annotation <mbt ... foo... >
    ),
  )
  inspect(
    gen_error("type t = [ A of int ] <json open_enum>"),
    content=(
      #|File "test.atd", line 1, characters 15-19:
      #|The argument of this variant must be of type string as imposed by <json open_enum>.
    ),
  )
}

///|
test "generated code" {
  inspect(
    gen(
      (
        #|type point = { x : float; ~y <mbt default="1.0"> : float }
        #|type shape = [ Dot | Circle of (point * float) ] <json repr="object">
      ),
    ),
    content=(
      #|// Generated by atdmbt from type definitions in 'test.atd'.
      #|//
      #|// Type-safe translations from/to JSON.
      #|//
      #|// For each type 'foo', there are the following functions:
      #|// - 'write_foo': convert a 'Foo' value into a JSON value;
      #|// - 'read_foo': convert a JSON value into a 'Foo' value;
      #|// - 'foo_of_json', 'foo_of_string' and 'string_of_foo': conveniences.
      #|//
      #|// This code requires the package "bobzhang/atd/runtime", imported with
      #|// the alias 'atd_runtime' in moon.pkg:
      #|//
      #|//   import {
      #|//     "bobzhang/atd/runtime" @atd_runtime,
      #|//   }
      #|
      #|///|
      #|pub(all) struct Point {
      #|  x : Double
      #|  y : Double
      #|} derive(Eq, Debug)
      #|
      #|///|
      #|/// Create a value of type `Point`.
      #|pub fn Point::new(
      #|  x~ : Double,
      #|  y? : Double = 1.0,
      #|) -> Point {
      #|  Point::{ x, y }
      #|}
      #|
      #|///|
      #|pub fn write_point(x : Point) -> Json {
      #|  let o : Map[String, Json] = Map([])
      #|  o["x"] = @atd_runtime.write_float(x.x)
      #|  o["y"] = @atd_runtime.write_float(x.y)
      #|  Json::object(o)
      #|}
      #|
      #|///|
      #|pub fn read_point(x : Json, path : @atd_runtime.Path) -> Point raise @atd_runtime.JsonError {
      #|  let o = @atd_runtime.read_object(x, path, "point")
      #|  Point::{
      #|    x: @atd_runtime.read_required_field(o, "point", "x", @atd_runtime.read_float, path),
      #|    y: match @atd_runtime.get_field(o, "y") {
      #|      Some(v) => @atd_runtime.read_float(v, path.key("y"))
      #|      None => 1.0
      #|    },
      #|  }
      #|}
      #|
      #|///|
      #|/// Convert a JSON value into a value of type `Point`.
      #|pub fn point_of_json(x : Json) -> Point raise @atd_runtime.JsonError {
      #|  read_point(x, @atd_runtime.Path::Root)
      #|}
      #|
      #|///|
      #|/// Parse a JSON string into a value of type `Point`.
      #|pub fn point_of_string(s : StringView) -> Point raise @atd_runtime.JsonError {
      #|  read_point(@atd_runtime.parse(s), @atd_runtime.Path::Root)
      #|}
      #|
      #|///|
      #|/// Serialize a value of type `Point` to JSON, compactly or with the
      #|/// given indentation.
      #|pub fn string_of_point(x : Point, indent? : Int = 0) -> String {
      #|  @atd_runtime.stringify(write_point(x), indent~)
      #|}
      #|
      #|///|
      #|pub impl ToJson for Point with to_json(self) {
      #|  write_point(self)
      #|}
      #|
      #|///|
      #|pub(all) enum Shape {
      #|  Dot
      #|  Circle(Point, Double)
      #|} derive(Eq, Debug)
      #|
      #|///|
      #|pub fn write_shape(x : Shape) -> Json {
      #|  match x {
      #|    Shape::Dot => Json::string("Dot")
      #|    Shape::Circle(v0, v1) => Json::object(Map::from_array([("Circle", Json::array([write_point(v0), @atd_runtime.write_float(v1)]))]))
      #|  }
      #|}
      #|
      #|///|
      #|pub fn read_shape(x : Json, path : @atd_runtime.Path) -> Shape raise @atd_runtime.JsonError {
      #|  match x {
      #|    String("Dot") => Shape::Dot
      #|    Object(_) =>
      #|      match @atd_runtime.read_single_field(x) {
      #|        Some(("Circle", v)) => { let p = path.key("Circle"); let a = @atd_runtime.read_tuple(v, p, 2); Shape::Circle(read_point(a[0], p.index(0)), @atd_runtime.read_float(a[1], p.index(1))) }
      #|        _ => @atd_runtime.bad_json("shape", x, path)
      #|      }
      #|    _ => @atd_runtime.bad_json("shape", x, path)
      #|  }
      #|}
      #|
      #|///|
      #|/// Convert a JSON value into a value of type `Shape`.
      #|pub fn shape_of_json(x : Json) -> Shape raise @atd_runtime.JsonError {
      #|  read_shape(x, @atd_runtime.Path::Root)
      #|}
      #|
      #|///|
      #|/// Parse a JSON string into a value of type `Shape`.
      #|pub fn shape_of_string(s : StringView) -> Shape raise @atd_runtime.JsonError {
      #|  read_shape(@atd_runtime.parse(s), @atd_runtime.Path::Root)
      #|}
      #|
      #|///|
      #|/// Serialize a value of type `Shape` to JSON, compactly or with the
      #|/// given indentation.
      #|pub fn string_of_shape(x : Shape, indent? : Int = 0) -> String {
      #|  @atd_runtime.stringify(write_shape(x), indent~)
      #|}
      #|
      #|///|
      #|pub impl ToJson for Shape with to_json(self) {
      #|  write_shape(self)
      #|}
      #|
    ),
  )
}

///|
test "output file name" {
  inspect(@mbtgen.output_file_name("path/to/Foo.atd"), content="foo.mbt")
  inspect(@mbtgen.output_file_name("bar"), content="bar.mbt")
}

///|
test "invalid MoonBit names" {
  inspect(
    gen_error("type t = { x <mbt name=\"foo-bar\">: int }"),
    content=(
      #|File "test.atd", line 1, characters 11-38:
      #|invalid MoonBit field name "foo-bar"
    ),
  )
  inspect(
    gen_error("type t = { x <mbt name=\"match\">: int }"),
    content=(
      #|File "test.atd", line 1, characters 11-36:
      #|invalid MoonBit field name "match"
    ),
  )
  inspect(
    gen_error("type t = [ A <mbt name=\"lowercase\"> ]"),
    content=(
      #|File "test.atd", line 1, characters 11-35:
      #|invalid MoonBit constructor name "lowercase"
    ),
  )
  inspect(
    gen_error("from m <mbt name=\"Bad\"> import t\ntype u = m.t"),
    content=(
      #|File "test.atd", line 1, characters 0-32:
      #|invalid MoonBit package alias "Bad"
    ),
  )
}

///|
/// Extract the declarations and function signatures of generated code.
fn signatures(code : String) -> String {
  code
  .split("\n")
  .filter(l => l.has_prefix("pub") || l.has_prefix("  "))
  .filter(l => {
    !l.has_prefix("   ") &&
    !l.contains("@atd_runtime.") &&
    !l.has_prefix("  o[")
  })
  .map(l => l.to_owned())
  .collect()
  .join("\n")
}

///|
test "no function name collisions" {
  let code = gen(
    (
      #|type a' = int
      #|type a_ = string
      #|type read_x = int
      #|type x_of_json = string
    ),
  )
  inspect(
    code
    .split("\n")
    .filter(l => l.has_prefix("pub fn"))
    .map(l => l.to_owned())
    .collect()
    .join("\n"),
    content=(
      #|pub fn write_a_(x : A) -> Json {
      #|pub fn read_a_(x : Json, path : @atd_runtime.Path) -> A raise @atd_runtime.JsonError {
      #|pub fn a__of_json(x : Json) -> A raise @atd_runtime.JsonError {
      #|pub fn a__of_string(s : StringView) -> A raise @atd_runtime.JsonError {
      #|pub fn string_of_a_(x : A, indent? : Int = 0) -> String {
      #|pub fn write_a__(x : A_) -> Json {
      #|pub fn read_a__(x : Json, path : @atd_runtime.Path) -> A_ raise @atd_runtime.JsonError {
      #|pub fn a___of_json(x : Json) -> A_ raise @atd_runtime.JsonError {
      #|pub fn a___of_string(s : StringView) -> A_ raise @atd_runtime.JsonError {
      #|pub fn string_of_a__(x : A_, indent? : Int = 0) -> String {
      #|pub fn write_read_x(x : ReadX) -> Json {
      #|pub fn read_read_x(x : Json, path : @atd_runtime.Path) -> ReadX raise @atd_runtime.JsonError {
      #|pub fn read_x_of_json(x : Json) -> ReadX raise @atd_runtime.JsonError {
      #|pub fn read_x_of_string(s : StringView) -> ReadX raise @atd_runtime.JsonError {
      #|pub fn string_of_read_x(x : ReadX, indent? : Int = 0) -> String {
      #|pub fn write_x_of_json_(x : XOfJson) -> Json {
      #|pub fn read_x_of_json_(x : Json, path : @atd_runtime.Path) -> XOfJson raise @atd_runtime.JsonError {
      #|pub fn x_of_json__of_json(x : Json) -> XOfJson raise @atd_runtime.JsonError {
      #|pub fn x_of_json__of_string(s : StringView) -> XOfJson raise @atd_runtime.JsonError {
      #|pub fn string_of_x_of_json_(x : XOfJson, indent? : Int = 0) -> String {
    ),
  )
}

///|
test "optional field of an aliased option type" {
  inspect(
    signatures(gen("type maybe = int option\ntype t = { ?x: maybe }")),
    content=(
      #|pub type Maybe = Int?
      #|pub fn write_maybe(x : Maybe) -> Json {
      #|pub fn string_of_maybe(x : Maybe, indent? : Int = 0) -> String {
      #|pub(all) struct T {
      #|  x : Int?
      #|pub fn T::new(
      #|  x? : Int,
      #|  T::{ x }
      #|pub fn write_t(x : T) -> Json {
      #|  let o : Map[String, Json] = Map([])
      #|  match x.x {
      #|  }
      #|  Json::object(o)
      #|  T::{
      #|  }
      #|pub fn string_of_t(x : T, indent? : Int = 0) -> String {
      #|pub impl ToJson for T with to_json(self) {
      #|  write_t(self)
    ),
  )
}

///|
test "imported types avoid builtin names" {
  let code = gen(
    (
      #|from ext import json, point <mbt name="Pt">
      #|type t = { a: ext.json; b: ext.point }
    ),
  )
  inspect(
    code
    .split("\n")
    .filter(l => l.contains("ext"))
    .map(l => l.to_owned())
    .collect()
    .join("\n"),
    content=(
      #|//     "<module>/ext" @ext,
      #|  a : @ext.Json_
      #|  b : @ext.Pt
      #|  a~ : @ext.Json_,
      #|  b~ : @ext.Pt,
      #|  o["a"] = @ext.write_json(x.a)
      #|  o["b"] = @ext.write_point(x.b)
      #|    a: @atd_runtime.read_required_field(o, "t", "a", @ext.read_json, path),
      #|    b: @atd_runtime.read_required_field(o, "t", "b", @ext.read_point, path),
    ),
  )
}

///|
test "lifted types inherit derive" {
  let code = gen("type t <mbt derive=\"\"> = [ A of { x: int } ]")
  inspect(
    code
    .split("\n")
    .filter(l => l.has_prefix("}") || l.has_prefix("pub(all)"))
    .map(l => l.to_owned())
    .collect()
    .join("\n"),
    content=(
      #|pub(all) enum T {
      #|}
      #|}
      #|}
      #|}
      #|}
      #|}
      #|}
      #|pub(all) struct TA {
      #|}
      #|}
      #|}
      #|}
      #|}
      #|}
      #|}
      #|}
    ),
  )
}

///|
test "open_enum rules, like atdgen" {
  inspect(
    gen_error("type t = [ A | B ] <json open_enum>"),
    content=(
      #|File "test.atd", line 1, characters 9-35:
      #|Missing catch-all case of the form `| Other of string`, required by <json open_enum>.
    ),
  )
  inspect(
    gen_error("type t = [ A | B of string | C of string ] <json open_enum>"),
    content=(
      #|File "test.atd", line 1, characters 9-59:
      #|Multiple variants have arguments, which doesn't make sense when combined with <json open_enum>.
    ),
  )
  inspect(
    gen_error("type t = [ A | B of int ] <json open_enum>"),
    content=(
      #|File "test.atd", line 1, characters 19-23:
      #|The argument of this variant must be of type string as imposed by <json open_enum>.
    ),
  )
  // aliases of string are accepted
  ignore(gen("type s = string\ntype t = [ A | B of s ] <json open_enum>"))
}

///|
test "duplicate JSON names" {
  inspect(
    gen_error(
      "type t = { a <json name=\"x\">: int; b <json name=\"x\">: string }",
    ),
    content=(
      #|File "test.atd", line 1, characters 35-60:
      #|Duplicate JSON field name "x", already used at File "test.atd", line 1, characters 11-33
    ),
  )
  inspect(
    gen_error("type t = [ A <json name=\"B\"> | B ]"),
    content=(
      #|File "test.atd", line 1, characters 31-32:
      #|Duplicate JSON variant name "B", already used at File "test.atd", line 1, characters 11-28
    ),
  )
}

///|
test "reserved names" {
  inspect(
    gen_error("type t = { x <mbt name=\"_\">: int }"),
    content=(
      #|File "test.atd", line 1, characters 11-32:
      #|invalid MoonBit field name "_"
    ),
  )
  inspect(
    gen_error("from atd_runtime import t\ntype u = atd_runtime.t"),
    content=(
      #|File "test.atd", line 1, characters 0-25:
      #|the package alias 'atd_runtime' is reserved for the runtime of atdmbt; choose another one with <mbt name="...">
    ),
  )
  inspect(
    gen_error("from m <mbt name=\"atd_runtime\"> import t\ntype u = m.t"),
    content=(
      #|File "test.atd", line 1, characters 0-40:
      #|the package alias 'atd_runtime' is reserved for the runtime of atdmbt; choose another one with <mbt name="...">
    ),
  )
}
