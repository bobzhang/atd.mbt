///|
fn gen(src : String) -> String raise {
  @mbtgen.generate(@utf8.encode(src), atd_filename="test.atd", on_warning=_ => {
    ()
  })
}

///|
fn gen_error(src : String) -> String raise {
  try gen(src) catch {
    @atd.AtdError(msg) => msg
    e => raise e
  } noraise {
    _ => fail("expected an error")
  }
}

///|
test "errors" {
  inspect(
    gen_error("type t = t list"),
    content=(
      #|File "test.atd", line 1, characters 0-15:
      #|not implemented in atdmbt: recursive type alias 't'; use a record or a sum type to break the cycle
    ),
  )
  inspect(
    gen_error("type t = u option\ntype u = t list"),
    content=(
      #|File "test.atd", line 1, characters 0-17:
      #|not implemented in atdmbt: recursive type alias 't'; use a record or a sum type to break the cycle
    ),
  )
  inspect(
    gen_error("type t = { ~x : u }\ntype u = [ A ]"),
    content=(
      #|File "test.atd", line 1, characters 11-17:
      #|a default field value must be specified with <mbt default="...">
    ),
  )
  inspect(
    gen_error("type t = int shared"),
    content=(
      #|File "test.atd", line 1, characters 8-19:
      #|not implemented in atdmbt: shared
    ),
  )
  inspect(
    gen_error("type t = { ?x : int }"),
    content=(
      #|File "test.atd", line 1, characters 11-19:
      #|the type of optional field 'x' should be of the form 'xxx option'
    ),
  )
  inspect(
    gen_error("type t = (int * int) list <json repr=\"object\">"),
    content=(
      #|File "test.atd", line 1, characters 9-46:
      #|not a (string * _) list
    ),
  )
  inspect(
    gen_error("type t = int <mbt foo>"),
    content=(
      #|File "test.atd", line 1, characters 18-21:
      #|Invalid or misplaced annotation <mbt ... foo... >
    ),
  )
  inspect(
    gen_error("type t = [ A of int ] <json open_enum>"),
    content=(
      #|File "test.atd", line 1, characters 0-38:
      #|<json open_enum> requires a variant with a string payload
    ),
  )
}

///|
test "generated code" {
  inspect(
    gen(
      (
        #|type point = { x : float; ~y <mbt default="1.0"> : float }
        #|type shape = [ Dot | Circle of (point * float) ] <json repr="object">
      ),
    ),
    content=(
      #|// Generated by atdmbt from type definitions in 'test.atd'.
      #|//
      #|// Type-safe translations from/to JSON.
      #|//
      #|// For each type 'foo', there are the following functions:
      #|// - 'write_foo': convert a 'Foo' value into a JSON value;
      #|// - 'read_foo': convert a JSON value into a 'Foo' value;
      #|// - 'foo_of_json', 'foo_of_string' and 'string_of_foo': conveniences.
      #|//
      #|// This code requires the package "bobzhang/atd/runtime", imported with
      #|// the alias 'atd_runtime' in moon.pkg:
      #|//
      #|//   import {
      #|//     "bobzhang/atd/runtime" @atd_runtime,
      #|//   }
      #|
      #|///|
      #|pub(all) struct Point {
      #|  x : Double
      #|  y : Double
      #|} derive(Eq, Debug)
      #|
      #|///|
      #|/// Create a value of type `Point`.
      #|pub fn Point::new(
      #|  x~ : Double,
      #|  y? : Double = 1.0,
      #|) -> Point {
      #|  Point::{ x, y }
      #|}
      #|
      #|///|
      #|pub fn write_point(x : Point) -> Json {
      #|  let o : Map[String, Json] = Map([])
      #|  o["x"] = @atd_runtime.write_float(x.x)
      #|  o["y"] = @atd_runtime.write_float(x.y)
      #|  Json::object(o)
      #|}
      #|
      #|///|
      #|pub fn read_point(x : Json, path : @atd_runtime.Path) -> Point raise @atd_runtime.JsonError {
      #|  let o = @atd_runtime.read_object(x, path, "point")
      #|  Point::{
      #|    x: @atd_runtime.read_required_field(o, "point", "x", @atd_runtime.read_float, path),
      #|    y: match @atd_runtime.get_field(o, "y") {
      #|      Some(v) => @atd_runtime.read_float(v, path.key("y"))
      #|      None => 1.0
      #|    },
      #|  }
      #|}
      #|
      #|///|
      #|/// Convert a JSON value into a value of type `Point`.
      #|pub fn point_of_json(x : Json) -> Point raise @atd_runtime.JsonError {
      #|  read_point(x, @atd_runtime.Path::Root)
      #|}
      #|
      #|///|
      #|/// Parse a JSON string into a value of type `Point`.
      #|pub fn point_of_string(s : StringView) -> Point raise @atd_runtime.JsonError {
      #|  read_point(@atd_runtime.parse(s), @atd_runtime.Path::Root)
      #|}
      #|
      #|///|
      #|/// Serialize a value of type `Point` to JSON, compactly or with the
      #|/// given indentation.
      #|pub fn string_of_point(x : Point, indent? : Int = 0) -> String {
      #|  @atd_runtime.stringify(write_point(x), indent~)
      #|}
      #|
      #|///|
      #|pub impl ToJson for Point with to_json(self) {
      #|  write_point(self)
      #|}
      #|
      #|///|
      #|pub(all) enum Shape {
      #|  Dot
      #|  Circle(Point, Double)
      #|} derive(Eq, Debug)
      #|
      #|///|
      #|pub fn write_shape(x : Shape) -> Json {
      #|  match x {
      #|    Shape::Dot => Json::string("Dot")
      #|    Shape::Circle(v0, v1) => Json::object(Map::from_array([("Circle", Json::array([write_point(v0), @atd_runtime.write_float(v1)]))]))
      #|  }
      #|}
      #|
      #|///|
      #|pub fn read_shape(x : Json, path : @atd_runtime.Path) -> Shape raise @atd_runtime.JsonError {
      #|  match x {
      #|    String("Dot") => Shape::Dot
      #|    Object(_) =>
      #|      match @atd_runtime.read_single_field(x) {
      #|        Some(("Circle", v)) => { let p = path.key("Circle"); let a = @atd_runtime.read_tuple(v, p, 2); Shape::Circle(read_point(a[0], p.index(0)), @atd_runtime.read_float(a[1], p.index(1))) }
      #|        _ => @atd_runtime.bad_json("shape", x, path)
      #|      }
      #|    _ => @atd_runtime.bad_json("shape", x, path)
      #|  }
      #|}
      #|
      #|///|
      #|/// Convert a JSON value into a value of type `Shape`.
      #|pub fn shape_of_json(x : Json) -> Shape raise @atd_runtime.JsonError {
      #|  read_shape(x, @atd_runtime.Path::Root)
      #|}
      #|
      #|///|
      #|/// Parse a JSON string into a value of type `Shape`.
      #|pub fn shape_of_string(s : StringView) -> Shape raise @atd_runtime.JsonError {
      #|  read_shape(@atd_runtime.parse(s), @atd_runtime.Path::Root)
      #|}
      #|
      #|///|
      #|/// Serialize a value of type `Shape` to JSON, compactly or with the
      #|/// given indentation.
      #|pub fn string_of_shape(x : Shape, indent? : Int = 0) -> String {
      #|  @atd_runtime.stringify(write_shape(x), indent~)
      #|}
      #|
      #|///|
      #|pub impl ToJson for Shape with to_json(self) {
      #|  write_shape(self)
      #|}
      #|
    ),
  )
}

///|
test "output file name" {
  inspect(@mbtgen.output_file_name("path/to/Foo.atd"), content="foo.mbt")
  inspect(@mbtgen.output_file_name("bar"), content="bar.mbt")
}
