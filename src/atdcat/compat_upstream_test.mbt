xxxxxxxxxxxxxxxxxxxxxxx should end up on its\\n    own line.\\n\\n    Second paragraph.\\n{{{\\n  Preformatted block.\\n    Second line with extra indentation.\\n}}}\\n    End.\\n\">:\n      int;\n    num2 <doc text=\"Another field.\">: int\n  }\n    <doc\n       text=\n         \"Record-level doc. This is a comment on the {{root}} type.\\n\\n     This is a second paragraph and here's a preformatted block:\\n{{{\\nfirst line of the preformatted block\\n  second line with extra indentation\\n}}}\\n     Escape these: \\\"\\\"\\\" and '''\\n\">\ntype alias = int list\ntype shape =\n  [ Circle of float | Square of float | Point ] <json repr=\"object\">\ntype pair <doc text=\"Def-level doc\"> =\n  (string * int) <doc text=\"Type-level doc\">\ntype require_field\n  <python\n     decorator=\"deco.deco1\"\n     decorator=\"deco.deco2(42)\"\n     decorator=\"dataclass(order=True)\"> = {\n  req: string\n}\ntype recursive_class = {\n  id: int;\n  flag: bool;\n  children: recursive_class list\n}\ntype default_list = { ~items: int list }\ntype tagged = { ext_tag: if.tag; priority: class.priority }\n",
