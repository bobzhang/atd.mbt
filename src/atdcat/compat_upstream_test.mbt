let upstream_inputs : Map[String, String] = {
  "atd-yamlx/examples/app_config.atd": "(*\n  ATD type definitions for a small application configuration file.\n\n  Prerequisites (install once via opam):\n    opam install atdml atd-yamlx yojson\n\n  Build and run (from this directory):\n    dune exec ./main.exe\n*)\n\n(* Log level: controls how much the application prints. *)\ntype log_level = [\n  | Debug\n  | Info\n  | Warn\n  | Error\n] <json repr=\"object\">\n(* ^^ Unit variants (no payload) are encoded as plain strings, so\n   \"Info\" stays as \"Info\" in JSON/YAML.  The object encoding only kicks in\n   for variants that carry a payload, e.g. {\"Circle\": 1.5} for a float.\n   In YAML:\n     log_level: Info *)\n\n(* Database backend selection. *)\ntype db_backend = [\n  | Sqlite of string       (* file path *)\n  | Postgres of pg_config\n] <json repr=\"object\">\n(* ^^ In YAML block style this looks like:\n     db:\n       Postgres:\n         host: db.example.com\n         port: 5432\n         dbname: myapp_prod\n         ssl: true *)\n\ntype pg_config = {\n  host    : string;\n  port    : int;\n  dbname  : string;\n  ~ssl    : bool;   (* defaults to false if absent *)\n}\n\n(* Top-level application config. *)\ntype app_config = {\n  ~name         : string;          (* application name; defaults to \"\" *)\n  log_level     : log_level;\n  db            : db_backend;\n  ~tags         : string list;     (* arbitrary labels; defaults to [] *)\n}\n",
  "atdcat/tests/input/schema.atd": "(* Input ATD file for testing the translation to JSON Schema *)\n\n<doc text=\"This is the title. Here's a code block:\n{{{\nthis is line 1\nthis is line 2\n}}}\n\">\n\ntype different_kinds_of_things = [\n  | Root <doc text=\"this is Root\">\n  | Thing <doc text=\"this is Thing\"> of int\n  | WOW <json name=\"wow\">\n  | Amaze <json name=\"!!!\"> of string list\n]\n\ntype root\n <doc text=\"This is the root object. For example, the empty object {{ {} }}\n            is invalid.\">\n = {\n  id\n    <json name=\"ID\">\n    <doc text=\"This is the 'id' field.\">\n    : string;\n  items\n    <doc text=\"An example of JSON value is {{ [[1, 2], [3], [4, 5, 6]] }}\">\n    : int list list;\n  ?maybe: int option;\n  ~extras: int list;\n  ~answer: int;\n  aliased: alias;\n  point: (float * float);\n  kinds: different_kinds_of_things list;\n  assoc1: (float * int) list;\n  assoc2: (string * int) list <json repr=\"object\">;\n  ~options: int option list;\n  ~nullables: int nullable list;\n  ~untyped_things: abstract list;\n}\n\ntype alias = int list\n\ntype pair = (string * int)\n",
  "atdcat/tests/input/soft_keywords.atd": "(*\n   Soft keywords are keywords that were introduced late\n   and need to be allowed as lowercase identifiers to avoid breaking\n   existing code.\n\n   See the ATD parser (mly) to see what these keywords are and how\n   they're handled.\n*)\n\n<from from=\"\" import>\n\nfrom from as as import import\n\ntype from = (from list * as.import)\n\ntype t = {\n  from: from;\n  ?import: int option;\n  ~as: int list;\n}\n",
  "atdcat/tests/input/test.atd": "(* -*- tuareg -*- *)\n\n<doc html=\"<p>This <b>is</b> a test.</p>\"\n     text=\"This is a test.\">\n\nfrom a <ocaml name=\"Aha\"> import t\nfrom a.b <ocaml name=\"AB\"> as c import t\n\n(* Double-quotes \"\\\"\" in comments must be matched. *)\n(* Don't worry about unmatched single quotes in comments. *)\ntype test_string_syntax = int\n  <a b=\"\\\"\">\n  <a b=\"'\">\n  <a b=\"\\'\">\n  <a b=\"\\\\\">\n  <a b='\\''>\n  <a b='\"'>\n  <a b='\\\"'>\n  <a b='\\\\'>\n\ntype x <a b> = y <a c>\ntype y <a b> = x <a c>  (* conflict or inheritance or anything: unspecified. *)\n\n\ntype ('a, 'b, 'c) yyy\n  <json something=\"aaaaaaaa\" blopblop>\n  <json something=\"aaaaaaaa\" blopblop>\n  <json something=\"aaaaaaaa\" blopblop> =\n    int\n\ntype z =\n    [\n    | X\n    | Y of x\n    | Z <a><b> of z ]\n\ntype ('a, 'b, 'c) tiptoptiptop <json phew> =\n    [ Foo <json foooooooooooooooooooooooooooooooooooooooooooooooo xyz=\"aaaa\">\n    | Fioo <json foooooooooooooooooooooooooooooooooooooooooo xyz=\"aaaa\"> of int\n    | Bar <json bar> of z\n    | Aaaaaaaaaaaaa ]\n      <doc text=\"\\\nFirst paragraph.\nFirst paragraph continued.\n\nSecond paragraph, with {{some code}}. And then some preformatted code:\n{{{\n1 2  3   4    5     6\n}}}\n\">\n\ntype kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk = int option\n\ntype ('a, 'b, 'ccccccccccccccccccccc) r = {\n  x <opt>:int;\n  y:float<x x> option;\n  adfadfafa\n    <json something=\"aaaaaaaa\" blopblop>\n    <json something=\"aaaaaaaa\" blopblop>\n    <json something=\"aaaaaaaa\" blopblop>:\n    (int list option,'ccccccccccccccccccccc,'ccccccccccccccccccccc)\n    tiptoptiptop;\n  llllllllllllllllllllllllll: kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk;\n  ?z : int option;\n  ~t : int;\n}\n\ntype tuple = (z * z * tuple option * kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk\n              * z * z * tuple option * kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk)\n<a b>\n\ntype tuple2 = (int * float)\n\ntype singleton = (int)\ntype zero_tuple = ()\n\ntype 'a i1 =\n    [ inherit 'a j2\n    | I1 ]\n\ntype 'a i2 =\n    [ inherit z\n    | I2 of 'a ]\n\ntype i = int i1\n\ntype 'b j2 = 'b i2\n\ntype i3 = [ inherit i | I1 of float | Y ]\n\n\ntype r1 = { x1 : int }\ntype r2 = { inherit r1; x2 : int }\n\ntype nullable_string = string nullable\n\ntype pair =\n    (<ocaml default=\"1\"> <foo bar> : int * <ocaml default=\"true\"> : bool)\n\ntype 'a abs = abstract\ntype int_abs = int abs\n\ntype 'a l = 'a list\ntype 'a int_l = int l\ntype int_list = int list <ocaml repr=\"list\">\ntype int_array = int list <ocaml repr=\"array\">\n\ntype 'a recur = { cyc : 'a recur option }\n\ntype 'a ta = [ Ta of 'a ] <ta f2=\"xyz\" f1>\ntype int_ta = int ta <ta f1=\"false\" f3=\"abc\">\ntype int_ta2 = int ta <ta f1=\"false\" f3=\"abc\"> <ocaml repr=\"classic\">\n\ntype timestamp = string wrap <ocaml module=\"Timestamp\">\n",
  "atdcat/tests/input/test2.atd": "type z = abstract list\n\ntype 'a t = int\ntype x = float t\n\ntype 'a l = [ Nil | Cons of ('a * 'a l) ]\n\ntype int_l = int l\ntype float_l = float l\ntype tup = (int l * float_l)\n\ntype ('a, 'b) tbl = ('a * 'b) list list\ntype 'a string_tbl = (string, 'a) tbl\ntype string_bool_tbl = bool string_tbl\n\ntype 'a b = 'a a\ntype 'a a = 'a b\ntype c = c a b a\n\n\ntype 'id gen_profile = {\n  id : 'id;\n  name : string option;\n  age : int option\n}\n\ntype basic_profile = int gen_profile\n\ntype profile_enhancements = {\n  credit_card_number : string\n}\n\ntype ('id, 'self) nested_profile = {\n  inherit 'id gen_profile;\n  sub_profiles : 'self list\n}\n\ntype profile = {\n  inherit (int, profile) nested_profile;\n  inherit profile_enhancements\n}\n(* expands to:\n\ntype profile = {\n  id: int;\n  name: string option;\n  age: int option;\n  sub_profiles: profile list;\n  credit_card_number: string\n}\n\n*)\n",
  "atdcpp/test/atd-input/everything.atd": "<cpp include=\"<stdint.h>\">\n<cpp namespace=\"my::custom::ns\">\n\ntype kind = [\n  | Root (* class name conflict *)\n  | Thing of int\n  | WOW <json name=\"wow\">\n  | Amaze <json name=\"!!!\"> of string list\n]\n\ntype frozen = [\n  | A\n  | B of int\n]\n\ntype enum_sumtype = [\n  | A\n  | B\n  | C\n] <cpp repr=\"enum\">\n\ntype ('a, 'b) parametrized_record = {\n  field_a: 'a;\n  ~field_b: 'b list;\n}\n\ntype 'a parametrized_tuple = ('a * 'a * int)\n\ntype root = {\n  id <json name=\"ID\">: string;\n  await: bool;\n  integer: int;\n  __init__ : float;\n  ~float_with_auto_default: float;\n  ~float_with_default <cpp default=\"0.1f\">: float;\n  items: int list list;\n  ?maybe: int option;\n  ~extras: int list;\n  ~answer <cpp default=\"42\">: int;\n  aliased: alias;\n  point: (float * float);\n  kind: kind;\n  kinds: kind list;\n  assoc1: (float * int) list;\n  assoc2: (string * int) list <json repr=\"object\">;\n  assoc3: (float * int) list <cpp repr=\"dict\">;\n  assoc4: (string * int) list <json repr=\"object\"> <cpp repr=\"dict\">;\n  nullables: int nullable list;\n  options: int option list;\n  untyped_things: abstract list;\n  parametrized_record: (int, float) parametrized_record;\n  parametrized_tuple: kind parametrized_tuple;\n  wrapped: st wrap <cpp t=\"uint16_t\" wrap=\"[](typedefs::St st){return st - 1;}\" unwrap=\"[](uint16_t e){return e + 1;}\">;\n  aaa: alias_of_alias_of_alias;\n  item: string wrap <cpp t=\"int\" wrap=\"std::stoi\" unwrap=\"std::to_string\">;\n  ee : enum_sumtype;\n}  \n\n\ntype st = int\ntype alias = int list\ntype alias2 = int list\ntype alias3 = int wrap <cpp t=\"uint32_t\" wrap=\"static_cast<uint32_t>\" unwrap=\"static_cast<int>\">\ntype alias_of_alias = alias3 wrap <cpp t=\"uint16_t\" wrap=\"static_cast<uint16_t>\" unwrap=\"static_cast<uint32_t>\">\ntype alias_of_alias_not_Wrapped = alias3\ntype alias_of_alias_of_alias = alias_of_alias_not_Wrapped\n\ntype password = int wrap <cpp t=\"uint32_t\" wrap=\"static_cast<uint32_t>\" unwrap=\"static_cast<int>\">\n\n\ntype credential = {\n  name: string;\n  password: int;\n}\n\ntype credentials = {\n  credentials: credential list;\n}\n\ntype credentials2 = credential list\n\ntype three_level_nested_list_record = {\n  field_a: int list list list\n}\n\n\ntype pair = (string * int)\n\ntype require_field = {\n  req: string;\n}\n\ntype recursive_class = {\n  id: int;\n  flag: bool;\n  children: recursive_class list;\n}\n\ntype default_list = {\n  ~items: int list;\n}\n\ntype record_with_wrapped_type = {\n  item: string wrap <cpp t=\"int\" wrap=\"std::stoi\" unwrap=\"std::to_string\">;\n}\n\ntype 'a recursive = 'a list\n\n(* This only works if the recursive member is always present. If it can optionally not be present, we need extra wrapping in an optional as below *)\ntype recursive_variant = [\n  | Integer of int\n  | Rec of recursive_variant wrap <cpp templatize t=\"std::shared_ptr\" wrap=\"_atd_wrap_shared_ptr\" unwrap=\"_atd_unwrap_shared_ptr\">\n]\n\ntype struct_with_recursive_variant = {\n  variant: recursive_variant;\n}\n\ntype recursive_record2 = {\n  id: int;\n  flag: bool;\n  children: recursive_record2 nullable wrap <cpp templatize t=\"std::shared_ptr\" wrap=\"_atd_wrap_shared_ptr\" unwrap=\"_atd_unwrap_shared_ptr\">;\n}\n\ntype null_opt = {\n  a : int;\n  b : int option;\n  c : int nullable;\n  ?f : int option;\n  ~h <cpp default=\"3\"> :int option;\n  ~i <cpp default=\"3\"> : int nullable;\n}\n\ntype empty_record = {\n}\n\n(* Test for <json repr=\"object\"> on sum types.\n   Tagged variants are encoded as single-key JSON objects {\"Constructor\": payload}\n   instead of the default two-element array [\"Constructor\", payload].\n   This matches the default Rust/Serde externally-tagged encoding and\n   also maps naturally to YAML (each variant is a single-key mapping). *)\ntype shape = [\n  | Circle of float  (* radius *)\n  | Square of float  (* side length *)\n  | Point            (* unit variant -- still encoded as a plain string *)\n] <json repr=\"object\">",
  "atdd/test/atd-input/everything.atd": "<dlang import=\"std.stdint : uint32_t, uint16_t\">\n\ntype kind = [\n  | Root (* class name conflict *)\n  | Thing of int\n  | WOW <json name=\"wow\">\n  | Amaze <json name=\"!!!\"> of string list\n]\n\ntype frozen = [\n  | A\n  | B of int\n]\n\ntype ('a, 'b) parametrized_record = {\n  field_a: 'a;\n  ~field_b: 'b list;\n}\n\ntype 'a parametrized_tuple = ('a * 'a * int)\n\ntype root = {\n  id <json name=\"ID\">: string;\n  await: bool;\n  integer: int;\n  __init__ : float;\n  ~float_with_auto_default: float;\n  ~float_with_default <dlang default=\"0.1\">: float;\n  items: int list list;\n  ?maybe: int option;\n  ~extras: int list;\n  ~answer <dlang default=\"42\">: int;\n  aliased: alias;\n  point: (float * float);\n  kind: kind;\n  kinds: kind list;\n  assoc1: (float * int) list;\n  assoc2: (string * int) list <json repr=\"object\">;\n  assoc3: (float * int) list <dlang repr=\"dict\">;\n  assoc4: (string * int) list <json repr=\"object\"> <dlang repr=\"dict\">;\n  nullables: int nullable list;\n  options: int option list;\n  untyped_things: abstract list;\n  parametrized_record: (int, float) parametrized_record;\n  parametrized_tuple: kind parametrized_tuple;\n  wrapped: st wrap <dlang t=\"uint16_t\" wrap=\"((St st) => st.to!int.to!uint16_t)\" unwrap=\"((uint16_t e) => St(e.to!int))\">;\n  aaa: alias_of_alias_of_alias;\n} \n\ntype st = int\ntype alias = int list\ntype alias2 = int list\ntype alias3 = int wrap <dlang t=\"uint32_t\" wrap=\"to!uint32_t\" unwrap=\"to!int\">\ntype alias_of_alias = alias3 wrap <dlang t=\"uint16_t\" wrap=\"to!uint16_t\" unwrap=\"to!uint32_t\">\ntype alias_of_alias_not_Wrapped = alias3\ntype alias_of_alias_of_alias = alias_of_alias_not_Wrapped\n\ntype password = int wrap <dlang t=\"uint32_t\" wrap=\"to!uint32_t\" unwrap=\"to!int\">\n\ntype credential = {\n  name: string;\n  password: password;\n}\n\ntype credentials = credential list\n\n\ntype pair = (string * int)\n\ntype require_field = {\n  req: string;\n}\n\ntype recursive_class = {\n  id: int;\n  flag: bool;\n  children: recursive_class list;\n}\n\ntype default_list = {\n  ~items: int list;\n}\n\ntype record_with_wrapped_type = {\n  item: string wrap <dlang t=\"int\" wrap=\"to!int\" unwrap=\"to!string\">;\n}\n\n(* Test for <json repr=\"object\"> on sum types.\n   Tagged variants are encoded as single-key JSON objects {\"Constructor\": payload}\n   instead of the default two-element array [\"Constructor\", payload].\n   This matches the default Rust/Serde externally-tagged encoding and\n   also maps naturally to YAML (each variant is a single-key mapping). *)\ntype shape = [\n  | Circle of float  (* radius *)\n  | Square of float  (* side length *)\n  | Point            (* unit variant -- still encoded as a plain string *)\n] <json repr=\"object\">\n",
  "atddiff/src/lib/Atddiff_output.atd": "(*\n   Type definitions used to build comparison results\n\n   We don't derive OCaml serializers from this file with atdgen due to\n   circular dependencies but we derive the OCaml types by calling atdgen\n   and keeping the result under source control:\n\n     atdgen -t Atddiff_output.atd\n\n   This provides an ATD specification to users who consume the JSON\n   output of the atddiff.\n*)\n\ntype position = {\n  path: string;\n  line: int;\n  column: int;\n}\n\ntype location = {\n  start: position;\n  end <ocaml name=\"end_\">: position;\n}\n\ntype direction = [ Backward | Forward | Both ] <ocaml repr=\"classic\">\n\ntype field_info = {\n  field_name: string\n}\n\ntype variant_info = {\n  variant_name: string\n}\n\ntype incompatibility_kind = [\n  | Missing_field of field_info\n  | Missing_variant of variant_info\n  | Missing_variant_argument of variant_info\n  | Default_required of field_info\n  | Incompatible_type\n  | Deleted_type\n  | Added_type\n] <ocaml repr=\"classic\">\n\n(*\n   Important things we want to report:\n   - the name of the root type definition\n   - the location of the mismatch in the old file and in the new file:\n\n       Old:\n         type a = int\n                  ^^^\n       New:\n         type a = b\n         type b = int\n                  ^^^\n     Note the location of the mismatch is not necessarily in the root type\n     definition.\n\n   - no duplicates. The same mismatch can affect multiple root types:\n\n       Old:\n         type a = { x: c }\n         type b = { x: c list }\n         type c = int\n                  ^^^\n       New:\n         type a = { x: c }\n         type b = { x: c list }\n         type c = float\n                  ^^^^^\n     The same int/float mismatch affects the root type definitions 'a' and 'b'.\n     In this case, we would report one finding that affects 'a' and 'b'.\n\n     Findings are deduplicated by their full contents i.e. we can have two\n     different findings at the same location(s).\n*)\ntype finding = {\n  (* A hexadecimal hash of all the other fields excluding location fields.\n     It is not necessarily unique but should be unique in most cases.\n     It's used for sorting, tracking, and referring to findings. *)\n  hash: string;\n\n  direction: direction;\n  kind: incompatibility_kind;\n  location_old: location option;\n  location_new: location option;\n\n  (* The description should not mention the affected root type definition\n     so as to allow the deduplication of findings. *)\n  description: string;\n\n  affected_types: string list;\n}\n\n(*\n   A result is a list of unique findings.\n*)\ntype result = {\n  findings: finding list;\n}\n",
  "atddiff/test/default/backward_incompatible_record_if_implicit_defaults_new.atd": "type backward_incompatible_record_if_implicit_defaults = {\n  becomes_required: int;\n}\n",
  "atddiff/test/default/backward_incompatible_record_if_implicit_defaults_old.atd": "type backward_incompatible_record_if_implicit_defaults = {\n  ~becomes_required: int;\n}\n",
  "atddiff/test/default/backward_incompatible_record_new.atd": "type backward_incompatible_record = {\n  added_field: int;\n  becomes_required: int;\n}\n",
  "atddiff/test/default/backward_incompatible_record_old.atd": "type backward_incompatible_record = {\n  ?becomes_required: int option;\n}\n",
  "atddiff/test/default/backward_incompatible_variant_new.atd": "type backward_incompatible_variant = [ A ]\n",
  "atddiff/test/default/backward_incompatible_variant_old.atd": "type backward_incompatible_variant = [ A | B ]\n",
  "atddiff/test/default/changed_renamed_new.atd": "(*\n   The root type hasn't changed its name but a field uses\n   a type that was renamed and has an incompatibility.\n*)\n\ntype root_type = {\n  field: new_name;\n}\n\ntype new_name = [ A of float ]\n",
  "atddiff/test/default/changed_renamed_old.atd": "(*\n   The root type hasn't changed its name but a field uses\n   a type that was renamed and has an incompatibility.\n*)\n\ntype root_type = {\n  field: old_name;\n}\n\ntype old_name = [ A of int ]\n",
  "atddiff/test/default/forward_incompatible_record_if_implicit_defaults_new.atd": "type forward_incompatible_record_if_implicit_defaults = {\n  ~becomes_optional: int;\n}\n",
  "atddiff/test/default/forward_incompatible_record_if_implicit_defaults_old.atd": "type forward_incompatible_record_if_implicit_defaults = {\n  becomes_optional: int;\n}\n",
  "atddiff/test/default/forward_incompatible_record_new.atd": "type forward_incompatible_record = {\n  ?becomes_optional: int option;\n}\n",
  "atddiff/test/default/forward_incompatible_record_old.atd": "type forward_incompatible_record = {\n  removed_field: int;\n  becomes_optional: int;\n}\n",
  "atddiff/test/default/forward_incompatible_variant_new.atd": "type forward_incompatible_variant = [ A | B ]\n",
  "atddiff/test/default/forward_incompatible_variant_old.atd": "type forward_incompatible_variant = [ A ]\n",
  "atddiff/test/default/ignored_type_parameters_are_ok_new.atd": "type 'a ignored_type_parameters_are_ok = 'a list\n",
  "atddiff/test/default/ignored_type_parameters_are_ok_old.atd": "type ('a, 'b) ignored_type_parameters_are_ok = 'a list\n",
  "atddiff/test/default/json_field_name_change_new.atd": "type with_field_renames = {\n  a : int;\n  b <json name=\"bee\"> : int;\n}\n",
  "atddiff/test/default/json_field_name_change_old.atd": "type with_field_renames = {\n  a <json name=\"a!\"> : int;\n  b : int;\n}\n",
  "atddiff/test/default/json_repr_change_new.atd": "type incompatible_record = {\n  json_repr_changes: (string * int) list <json repr=\"object\">;\n}\n",
  "atddiff/test/default/json_repr_change_old.atd": "type incompatible_record = {\n  json_repr_changes: (string * int) list;\n}\n",
  "atddiff/test/default/json_variant_name_change_new.atd": "type with_constructor_renames = [\n  | A <json name=\"a!\">\n  | B <json name=\"b!\"> of int\n  | C\n  | D of int\n]\n",
  "atddiff/test/default/json_variant_name_change_old.atd": "type with_constructor_renames = [\n  | A\n  | B of int\n  | C <json name=\"cee\">\n  | D <json name=\"dee\"> of int\n]\n",
  "atddiff/test/default/recursive_new.atd": "(* Check that recursive definitions don't cause infinite loops or some\n   other problem. *)\n\ntype unchanged_recursive = [ Cons of (int * unchanged_recursive) | Nil  ]\n\ntype unchanged_recursive_a = [ A of unchanged_recursive_b ]\ntype unchanged_recursive_b = [ B of unchanged_recursive_a ]\n\ntype changed_recursive = [ A of changed_recursive | B ]\ntype depends_on_changed_recursive = changed_recursive list\n",
  "atddiff/test/default/recursive_old.atd": "(* Check that recursive definitions don't cause infinite loops or some\n   other problem. *)\n\ntype unchanged_recursive = [ Cons of (int * unchanged_recursive) | Nil  ]\n\ntype unchanged_recursive_a = [ A of unchanged_recursive_b ]\ntype unchanged_recursive_b = [ B of unchanged_recursive_a ]\n\ntype changed_recursive = [ A of changed_recursive ]\ntype depends_on_changed_recursive = changed_recursive list\n",
  "atddiff/test/default/recursive_types_new.atd": "(* Check that recursive definitions don't cause infinite loops or some\n   other problem. *)\n\ntype unchanged_recursive = [ Cons of (int * unchanged_recursive) | Nil  ]\n\ntype unchanged_recursive_a = [ A of unchanged_recursive_b ]\ntype unchanged_recursive_b = [ B of unchanged_recursive_a ]\n",
  "atddiff/test/default/recursive_types_old.atd": "(* Check that recursive definitions don't cause infinite loops or some\n   other problem. *)\n\ntype unchanged_recursive = [ Cons of (int * unchanged_recursive) | Nil  ]\n\ntype unchanged_recursive_a = [ A of unchanged_recursive_b ]\ntype unchanged_recursive_b = [ B of unchanged_recursive_a ]\n",
  "atddiff/test/default/swapped_type_parameters_new.atd": "type ('a, 'b) unchanged_type_parameters = { x: ('a * 'b) list }\n\ntype ('a, 'b) swapped_type_parameters = { x: ('b * 'a) list }\n",
  "atddiff/test/default/swapped_type_parameters_old.atd": "type ('k, 'v) unchanged_type_parameters = { x: ('k * 'v) list }\n\ntype ('k, 'v) swapped_type_parameters = { x: ('k * 'v) list }\n",
  "atddiff/test/default/type_arity_change_new.atd": "type 'a type_arity_change = ('a * 'a) list\n",
  "atddiff/test/default/type_arity_change_old.atd": "type ('a, 'b) type_arity_change = ('a * 'b) list\n",
  "atddiff/test/default/type_name_change_new.atd": "(* Not detected as a rename but as a deleted/created type name. *)\ntype new_name_for_root_type = int\n\n(* Undetected incompatibility. Reported as a deleted/created root type name. *)\ntype new_name_for_root_type_with_changes = {\n  x: float;\n}\n",
  "atddiff/test/default/type_name_change_old.atd": "(* Not detected as a rename but as a deleted/created type name. *)\ntype old_name_for_root_type = int\n\n(* Undetected incompatibility. Reported as a deleted/created root type name. *)\ntype old_name_for_root_type_with_changes = {\n  x: int;\n}\n",
  "atddiff/test/default/unchanged_new.atd": "(****************************************************************************)\n(* Type definitions without breaking changes in both directions *)\n(****************************************************************************)\n\ntype unchanged_variant = [\n  | A\n  | B of int\n]\n\n(* The order of the type definitions changed on purpose. *)\ntype unchanged_record = {\n  a: int;\n  ?b: int option;\n  ~c: int list;\n  d <new>: int <new2 a=\"b\">;\n  renamed_field_type: new_name_for_unchanged_type;\n}\n\ntype new_name_for_unchanged_type = [ Thing ]\n",
  "atddiff/test/default/unchanged_old.atd": "(****************************************************************************)\n(* Type definitions without breaking changes in both directions *)\n(****************************************************************************)\n\ntype unchanged_record = {\n  a: int;\n  ?b: int option;\n  ~c: int list;\n  d <old>: int <old2>;\n  renamed_field_type: old_name_for_unchanged_type;\n}\n\ntype unchanged_variant = [\n  | A\n  | B of int\n]\n\ntype old_name_for_unchanged_type = [ Thing ]\n",
  "atddiff/test/default/unchanged_renamed_nonroot_type_new.atd": "type root = {\n  field: not_a_root_type_renamed list;\n}\n\ntype not_a_root_type_renamed = not_a_root_type2_renamed\n\ntype not_a_root_type2_renamed = [ A ]\n",
  "atddiff/test/default/unchanged_renamed_nonroot_type_old.atd": "type root = {\n  field: not_a_root_type list;\n}\n\ntype not_a_root_type = not_a_root_type2\n\ntype not_a_root_type2 = [ A ]\n",
  "atddiff/test/filter/filter_new.atd": "(*\n   Test that the command-line filters make the correct selection of findings.\n*)\n\ntype a = {\n  added_field: int; (* backward incompatibility *)\n  changing_type: string;\n}\n\ntype b = {\n  uses_a: a; (* backward and forward incompatibilities *)\n}\n\n(* Findings affecting only 'c' are ignored. *)\ntype c = {\n  added_field_in_ignored_type: int;\n}\n",
  "atddiff/test/filter/filter_old.atd": "(*\n   Test that the command-line filters make the correct selection of findings.\n*)\n\ntype a = {\n  deleted_field: int; (* forward incompatibility *)\n  changing_type: int;\n}\n\ntype b = {\n  uses_a: a; (* backward and forward incompatibilities *)\n}\n\n(* Findings affecting only 'c' are ignored. *)\ntype c = {\n  deleted_field_in_ignored_type: int;\n}\n",
  "atddiff/test/filter_backward/filter_new.atd": "(*\n   Test that the command-line filters make the correct selection of findings.\n*)\n\ntype a = {\n  added_field: int; (* backward incompatibility *)\n  changing_type: string;\n}\n\ntype b = {\n  uses_a: a; (* backward and forward incompatibilities *)\n}\n",
  "atddiff/test/filter_backward/filter_old.atd": "(*\n   Test that the command-line filters make the correct selection of findings.\n*)\n\ntype a = {\n  deleted_field: int; (* forward incompatibility *)\n  changing_type: int;\n}\n\ntype b = {\n  uses_a: a; (* backward and forward incompatibilities *)\n}\n",
  "atddiff/test/filter_forward/filter_new.atd": "(*\n   Test that the command-line filters make the correct selection of findings.\n*)\n\ntype a = {\n  added_field: int; (* backward incompatibility *)\n  changing_type: string;\n}\n\ntype b = {\n  uses_a: a; (* backward and forward incompatibilities *)\n}\n",
  "atddiff/test/filter_forward/filter_old.atd": "(*\n   Test that the command-line filters make the correct selection of findings.\n*)\n\ntype a = {\n  deleted_field: int; (* forward incompatibility *)\n  changing_type: int;\n}\n\ntype b = {\n  uses_a: a; (* backward and forward incompatibilities *)\n}\n",
  "atddiff/test/json_defaults/backward_incompatible_record_if_implicit_defaults_new.atd": "type backward_incompatible_record_if_implicit_defaults = {\n  becomes_required: int;\n}\n",
  "atddiff/test/json_defaults/backward_incompatible_record_if_implicit_defaults_old.atd": "type backward_incompatible_record_if_implicit_defaults = {\n  ~becomes_required: int;\n}\n",
  "atddiff/test/json_defaults/forward_incompatible_record_if_implicit_defaults_new.atd": "type forward_incompatible_record_if_implicit_defaults = {\n  ~becomes_optional: int;\n}\n",
  "atddiff/test/json_defaults/forward_incompatible_record_if_implicit_defaults_old.atd": "type forward_incompatible_record_if_implicit_defaults = {\n  becomes_optional: int;\n}\n",
  "atddiff/test/json_defaults_new/backward_incompatible_record_if_implicit_defaults_new.atd": "type backward_incompatible_record_if_implicit_defaults = {\n  becomes_required: int;\n}\n",
  "atddiff/test/json_defaults_new/backward_incompatible_record_if_implicit_defaults_old.atd": "type backward_incompatible_record_if_implicit_defaults = {\n  ~becomes_required: int;\n}\n",
  "atddiff/test/json_defaults_new/forward_incompatible_record_if_implicit_defaults_new.atd": "type forward_incompatible_record_if_implicit_defaults = {\n  ~becomes_optional: int;\n}\n",
  "atddiff/test/json_defaults_new/forward_incompatible_record_if_implicit_defaults_old.atd": "type forward_incompatible_record_if_implicit_defaults = {\n  becomes_optional: int;\n}\n",
  "atddiff/test/json_defaults_old/backward_incompatible_record_if_implicit_defaults_new.atd": "type backward_incompatible_record_if_implicit_defaults = {\n  becomes_required: int;\n}\n",
  "atddiff/test/json_defaults_old/backward_incompatible_record_if_implicit_defaults_old.atd": "type backward_incompatible_record_if_implicit_defaults = {\n  ~becomes_required: int;\n}\n",
  "atddiff/test/json_defaults_old/forward_incompatible_record_if_implicit_defaults_new.atd": "type forward_incompatible_record_if_implicit_defaults = {\n  ~becomes_optional: int;\n}\n",
  "atddiff/test/json_defaults_old/forward_incompatible_record_if_implicit_defaults_old.atd": "type forward_incompatible_record_if_implicit_defaults = {\n  becomes_optional: int;\n}\n",
  "atddiff/test/json_output/all_errors_new.atd": "type created = int\n\ntype changed_record = {\n  new_field: int;\n  ?becomes_optional: int option;\n  ~becomes_optional_with_default: int;\n  becomes_required: int;\n  with_default_becomes_required: int;\n  renamed_field <json name=\"RENAMED_FIELD\">: int;\n}\n\ntype changed_variant = [\n  | New_case\n  | New_case_with_arg of int\n  | Added_arg of float\n  | Removed_arg\n  | Changed_arg of bool\n  | Renamed_case <json repr=\"RENAMED_CASE\">\n]\n\ntype indirect_changes = {\n  record: changed_record;\n  variant: changed_variant;\n}\n\ntype changed_map1 = (string * int) list\ntype changed_map2 = (string * int) list <json repr=\"object\">\n",
  "atddiff/test/json_output/all_errors_old.atd": "type deleted = int\n\ntype changed_record = {\n  deleted_field: int;\n  becomes_optional: int;\n  becomes_optional_with_default: int;\n  ?becomes_required: int option;\n  ~with_default_becomes_required: int;\n  renamed_field: int;\n}\n\ntype changed_variant = [\n  | Deleted_case\n  | Deleted_case_with_arg of string\n  | Added_arg\n  | Removed_arg of int\n  | Changed_arg of int\n  | Renamed_case\n]\n\ntype indirect_changes = {\n  record: changed_record;\n  variant: changed_variant;\n}\n\ntype changed_map1 = (string * int) list <json repr=\"object\">\ntype changed_map2 = (string * int) list\n",
  "atddiff/test/no_locations_json/ordering_new.atd": "type a = string\ntype b = string\ntype c = string\ntype d = string\ntype e = string\ntype f = string\n",
  "atddiff/test/no_locations_json/ordering_old.atd": "type a = int\ntype b = int list\ntype c = (b * b)\ntype d = (a * b)\ntype e = c list\ntype f = d list\n",
  "atddiff/test/no_locations_json/same_hash_new.atd": "type t = (string * string)\n",
  "atddiff/test/no_locations_json/same_hash_old.atd": "(*\n  This test produces two findings with the same hash ID\n*)\n\ntype t = (int * int)\n",
  "atddiff/test/no_locations_json/simple_new.atd": "type t = string\n",
  "atddiff/test/no_locations_json/simple_old.atd": "type t = int\n",
  "atddiff/test/no_locations_text/ordering_new.atd": "type a = string\ntype b = string\ntype c = string\ntype d = string\ntype e = string\ntype f = string\n",
  "atddiff/test/no_locations_text/ordering_old.atd": "type a = int\ntype b = int list\ntype c = (b * b)\ntype d = (a * b)\ntype e = c list\ntype f = d list\n",
  "atddiff/test/no_locations_text/same_hash_new.atd": "type t = (string * string)\n",
  "atddiff/test/no_locations_text/same_hash_old.atd": "(*\n  This test produces two findings with the same hash ID\n*)\n\ntype t = (int * int)\n",
  "atddiff/test/no_locations_text/simple_new.atd": "type t = string\n",
  "atddiff/test/no_locations_text/simple_old.atd": "type t = int\n",
  "atddiff/test/safe_ignore/safe_ignore_new.atd": "type nonrec_root = {\n  field: b;\n  new_field: int;\n  inherit c;\n}\n\ntype b = int\n\ntype c = {\n  field2: int;\n}\n\ntype recursive1 = [ Rec2 of recursive2 list | New_case ]\ntype recursive2 = [ Rec1 of recursive1 list ]\n\ntype new_type = string\n",
  "atddiff/test/safe_ignore/safe_ignore_old.atd": "type nonrec_root = {\n  field: b;\n  deleted_field: int;\n  inherit c;\n}\n\ntype b = int\n\ntype c = {\n  field2: int;\n}\n\ntype recursive1 = [ Rec2 of recursive2 list | Deleted_case ]\ntype recursive2 = [ Rec1 of recursive1 list ]\n\ntype deleted_type = int\n",
  "atddiff/test/safe_ignore_error1/safe_ignore_new.atd": "type nonrec_root = {\n  field: b;\n  new_field: int;\n  inherit c;\n}\n\ntype b = int\n\ntype c = {\n  field2: int;\n}\n\ntype recursive1 = [ Rec2 of recursive2 list | New_case ]\ntype recursive2 = [ Rec1 of recursive1 list ]\n\ntype new_type = string\n",
  "atddiff/test/safe_ignore_error1/safe_ignore_old.atd": "type nonrec_root = {\n  field: b;\n  deleted_field: int;\n  inherit c;\n}\n\ntype b = int\n\ntype c = {\n  field2: int;\n}\n\ntype recursive1 = [ Rec2 of recursive2 list | Deleted_case ]\ntype recursive2 = [ Rec1 of recursive1 list ]\n\ntype deleted_type = int\n",
  "atddiff/test/safe_ignore_error2/safe_ignore_new.atd": "type nonrec_root = {\n  field: b;\n  new_field: int;\n  inherit c;\n}\n\ntype b = int\n\ntype c = {\n  field2: int;\n}\n\ntype recursive1 = [ Rec2 of recursive2 list | New_case ]\ntype recursive2 = [ Rec1 of recursive1 list ]\n\ntype new_type = string\n",
  "atddiff/test/safe_ignore_error2/safe_ignore_old.atd": "type nonrec_root = {\n  field: b;\n  deleted_field: int;\n  inherit c;\n}\n\ntype b = int\n\ntype c = {\n  field2: int;\n}\n\ntype recursive1 = [ Rec2 of recursive2 list | Deleted_case ]\ntype recursive2 = [ Rec1 of recursive1 list ]\n\ntype deleted_type = int\n",
  "atdgen/example/format_v1.atd": "(* Older version of an imagined data format *)\n\ntype t = {\n  a : int option;\n  b : bool;\n  ?c : int option;\n  ~d : float;\n}\n",
  "atdgen/example/format_v2.atd": "(* Newer version of an imagined data format. Compare to `format_v1.atd'. *)\n\ntype t = {\n  a : int option;\n  (* removed field b, making newer data unreadable with older software since\n     b was not optional. *)\n  ?c : int option;\n  ~d : float;\n  ~e : string list; (* added optional field e, allowing newer software\n                       to read older data. *)\n}\n",
  "atdgen/test/melange/melangespec.atd": "\ntype label = string\n\ntype valid = bool\n\ntype labeled =\n  { flag: valid\n  ; lb: label\n  ; count: int\n  }\n\ntype point = (int * int * string * unit)\n\ntype 'a param =\n  { data: 'a\n  ; nothing: unit\n  }\n\ntype 'a param_similar =\n  { data: 'a\n  ; something: int\n  }\n\ntype 'a same_pair = ('a * 'a)\n\ntype ('a, 'b) pair =\n  { left: 'a\n  ; right: 'b\n  }\n\n\ntype 'a pairs = ('a, 'a) pair list\n\ntype id = string <ocaml validator=\"fun path x -> assert false\"> wrap\n   <ocaml t=\"[ `Id of string ]\"\n          wrap=\"fun s -> `Id s\"\n          unwrap=\"function `Id s -> s\"\n          validator=\"fun path x ->\n                       match x with\n                         `Id \\\"\\\" -> failwith \\\"empty\\\"\n                       | _ -> None\">\n\ntype 'a simple_var =\n  [ Foo of (int * int)\n  | Bar\n  | Foobar of 'a\n  | Foo_id of id\n  ]\n\ntype simple_vars = unit simple_var list\n\ntype v1 =\n [ V1_foo of bool\n | V2_bar of int\n ] <ocaml repr=\"classic\">\n\ntype v2 =\n [ V1_foo of int\n | V2_bar of bool\n ] <ocaml repr=\"classic\">\n\ntype from_module_a <ocaml from=\"A\"> = abstract\n\ntype record_json_name =\n  { foo <json name=\"bar\"> : int\n  }\n\ntype single_tuple = [ Single_tuple of (int) ]\n\n(*** Test json adapters ***)\n\ntype adapted = [\n  | A of a\n  | B of b\n] <json adapter.ocaml=\"Atdgen_codec_runtime.Json_adapter.Type_field\">\n\ntype a = {\n  thing: string;\n  other_thing: bool;\n}\n\ntype b = {\n  thing: int;\n}\n\ntype recurse = {\n  recurse_items: recurse list;\n}\n\ntype mutual_recurse1 = {\n  mutual_recurse2: mutual_recurse2;\n}\n\ntype mutual_recurse2 = {\n  mutual_recurse1: mutual_recurse1;\n}\n\ntype using_object = {\n   f : (string * int) list <json repr=\"object\">;\n }\n\ntype variant1 = [\n  | A of string\n  | B\n] <ocaml repr=\"classic\">\n\ntype variant2 = [\n  | A\n  | C\n] <ocaml repr=\"classic\">\n\ntype with_open_enum = [\n  | Alpha\n  | Beta\n  | Other of string\n] <json open_enum>\n\ntype with_open_enum_list = with_open_enum list\n\ntype variant3 = [\n  | C\n  | B\n  | A of string\n] <ocaml repr=\"classic\"> <json open_enum>\n",
  "atdgen/test/spec_js/spec.atd": "type r1 = { r1: string }\ntype r2 = { r2: int option }\ntype r3 = { ?r3: int option }\ntype r4 = { ~r4: bool }\ntype r5 = { ~r5: int option }\ntype r6 = { ~r6 <ocaml default=\"42\">: int }\ntype r7 = { ~r7 <ocaml repr=\"int64\">: int }\ntype r8 = { ~r8 <ocaml name=\"r888\">: int list }\n\ntype j1 = string list\ntype j2 = unit\ntype j3 = int list <ocaml repr=\"array\">\ntype j4 = int <ocaml repr=\"char\">\n\ntype o1 = (string * int) list <json repr=\"object\">\ntype o2 = (string * int) list <json repr=\"object\"> <ocaml repr=\"array\">\n\ntype t1 = (int * string)\ntype t2 = (int * int * <ocaml default=\"-1\"> : int)\n\ntype v1 =\n  [ V1\n  | V2 <json name=\"v22\">\n  | V3 of string\n  | V4 <json name=\"v44\"> of int\n  | V5 of bool option]\n\ntype v1list = v1 list\n\ntype v2 =\n  { v2 <json tag_field=\"kind\">: [ A | B of int ]\n  }\n\ntype v3 = [ C1 | C2 of bool] <ocaml repr=\"classic\">\n\ntype v3list = v3 list\n\ntype age = int wrap\n  <ocaml\n    t=\"[`Age of int]\"\n    wrap=\"fun i -> assert (i < 100 && i > 0); `Age i\"\n    unwrap=\"fun (`Age i) -> max 1 (min i 100)\">\n\ntype ages = age list\n\ntype open_enum = [\n  | Alpha\n  | Beta\n  | Other of string\n] <json open_enum>\n\ntype open_enum_list = open_enum list\n",
  "atdgen/test/test.atd": "<doc text=\"This is just a test.\">\n\ntype def <ocaml_biniou module=\"Test_lib.Biniou\">\n         <ocaml_json module=\"Test_lib.Json\"> = abstract\n  <doc text=\"\n         }}}abc{{def}}ghi\n{{{\nj  *  j\n k * k\n  l*l\n}}}{{{mno}}}\n\n\n\n{{pqr}}{stu}vwx\n\n         yz\n\n{{} [ ] {v }}\n{{{\n} [x] v} {v [ @ \\\n}}}\n      \">\n\ntype r = {\n  a : int <ocaml validator=\"fun _ _ -> None\">;\n  b <ocaml mutable> : bool;\n  c : p;\n}\n\ntype p =\n    [ A | B of r | C ]\n    <ocaml validator=\"\\\n      fun path x ->\n         match x with\n           `A -> Some (Atdgen_runtime.Util.Validation.error path)\n         | _ -> None\">\n\ntype star_rating = int <ocaml valid=\"fun x -> x >= 1 && x <= 5\">\n\ntype p'' = int p'\n\ntype 'a p' = [ A | Bb of 'a p' | Ccccc of 'a ] <ocaml repr=\"classic\">\n\ntype hello = [ Hello of string | World ] <ocaml repr=\"poly\">\n\ntype tup = (int * test)\n\n\ntype test_variant =\n    [ Case1 | Case2 of int | Case3 of string | Case4 of test_variant list ]\n\ntype date = (int * int nullable * int nullable)\n\ntype floats = {\n  f32 : float <biniou repr=\"float32\">;\n  f64 : float;\n}\n\ntype mixed_record = {\n  ?field0 : int option;\n  ?field1 : float option;\n  field2 : string option;\n  field3 : int <ocaml repr=\"int64\"> <biniou repr=\"int64\">;\n  field4 : float list <ocaml repr=\"array\">;\n  ?field5 : bool option;\n  ?field6 : string option;\n  field7 : test_variant;\n  field8 : string list <ocaml repr=\"array\">;\n  field9 : (\n    int <biniou repr=\"uvint\">\n    * int <biniou repr=\"int8\">\n    * int <ocaml repr=\"char\"> <biniou repr=\"int8\">\n    * int <biniou repr=\"int16\">\n\n    * int <ocaml repr=\"int32\"> <biniou repr=\"int32\">\n    * int <ocaml repr=\"int64\"> <biniou repr=\"int64\">\n  );\n  field10 : bool;\n  ~field11 : bool;\n  field12 : unit list;\n  field13 : string option list;\n  field14 : date;\n}\n\ntype mixed =\n    (mixed_record list <ocaml repr=\"array\"> <biniou repr=\"table\">\n    * mixed_record list <ocaml repr=\"array\">) list\n\ntype test = {\n  ?x0 : int option;\n  ?x1 : float option;\n  x2 : mixed;\n  x3 : mixed_record list;\n  x4 : int <ocaml repr=\"int64\"> <biniou repr=\"int64\">;\n}\n\ntype base = {\n  b0 : int;\n  b1 : bool;\n}\n\ntype extended = {\n  b0 <ocaml name=\"b0x\"> : int;\n  b1 <ocaml name=\"b1x\"> : bool\n    <ocaml validator=\"\\\n      fun path x ->\n        if x = false then None else Some (Atdgen_runtime.Util.Validation.error path)\">;\n  b2 <ocaml name=\"b2x\"> : string;\n  ?b3 <ocaml name=\"b3x\"> : string option;\n  b4 <ocaml name=\"b4x\"> : string option;\n  ~b5 <ocaml name=\"b5x\" default=\"0.5\"> : float;\n} <ocaml validator=\"\\\n    fun path x ->\n      if x.b0x >= 0 then None\n      else Some (Atdgen_runtime.Util.Validation.error path)\">\n\ntype val1 = { val1_x : int\n              <ocaml validator=\"fun path _ -> \\\n                                  Some (Atdgen_runtime.Util.Validation.error path)\"> }\ntype val2 = {\n  val2_x : val1;\n  ?val2_y : val1 option;\n}\n\ntype base_tuple = (int * float)\n    <ocaml validator=\"\\\n      fun path (i, f) -> \\\n        if float i < f then None \\\n        else Some (Atdgen_runtime.Util.Validation.error ~msg:\\\"i < f\\\" path)\">\ntype extended_tuple =\n    (int\n     * float\n     * <ocaml default=\"true\"> : bool\n     * <ocaml default=\"None\"> : int option\n     * string\n     * <ocaml default=\"[]\"> : string list)\n\ntype option_validation =\n    int <ocaml validator=\"fun path _ -> Some (Atdgen_runtime.Util.Validation.error path)\">\n      option\n\ntype ('x, 'y) poly = {\n  fst : 'x list;\n  snd : ('x, 'y) poly option;\n}\n\n\n(*\ntype field_hash_clash = {\n  workshop1 : bool;\n  examples3 : bool;\n}\n\ntype variant_hash_clash = [ X_workshop1 | X_examples3 ]\n*)\n\ntype int_assoc_list =\n    (string * int) list <json repr=\"object\">\n\ntype int_assoc_array =\n    (string * int) list <ocaml repr=\"array\"> <json repr=\"object\">\n\ntype 'a abs1 = 'a list\ntype 'a abs2 = 'a list\ntype 'a abs3 = 'a list\n\ntype intopt = int option\n\ntype int8 = int <biniou repr=\"int8\">\ntype char = int <ocaml repr=\"char\"> <biniou repr=\"int8\">\ntype int32 = int <ocaml repr=\"int32\"> <biniou repr=\"int32\">\ntype int64 = int <ocaml repr=\"int64\"> <biniou repr=\"int64\">\ntype 'a array = 'a list <ocaml repr=\"array\">\n\ntype id = string <ocaml validator=\"fun path x -> assert false\"> wrap\n   <ocaml t=\"[ `Id of string ]\"\n          wrap=\"fun s -> `Id s\"\n          unwrap=\"function `Id s -> s\"\n          validator=\"fun path x ->\n                       match x with\n                         `Id \\\"\\\" -> failwith \\\"empty\\\"\n                       | _ -> None\">\n\ntype json_map = (id * int) list <json repr=\"object\">\n\ntype natural = int wrap <ocaml module=\"Test_lib.Natural\">\ntype even_natural = natural wrap <ocaml module=\"Test_lib.Even_natural\">\n\ntype some_record = {\n  some_field : int <ocaml validator=\"fun path x -> failwith \\\"passed\\\"\">\n}\ntype no_real_wrap = some_record wrap\n\ntype unixtime_list = float <json repr=\"int\"> list\n\ntype precision = {\n  sqrt2_5 : float <json precision=\"5\">;\n  small_2 : float <json precision=\"2\">;\n  large_2 : float <json precision=\"2\">;\n}\n\ntype 'a generic = { x294623: int; }\ntype specialized = string generic\n\ntype validate_me =\n  string\n    <ocaml valid=\"fun s -> true\">\n      list\n        <ocaml valid=\"fun l -> true\">\n\ntype validated_string_check = string <ocaml valid=\"fun s -> s = \\\"abc\\\"\">\n\ntype test_field_prefix = {\n  hello: bool;\n  world: int;\n} <ocaml field_prefix=\"theprefix_\">\n",
  "atdgen/test/test2.atd": "type ('aa, 'bb) poly <ocaml_biniou module=\"Test\">\n                     <ocaml_json module=\"Testj\"> = abstract\n\ntype poly_int2 = (int, int) poly\ntype poly_int_string = (int, string) poly\n\ntype test2 = {\n  test0 : poly_int2;\n  test1 : (int, string option) poly\n}\n",
  "atdgen/test/test3j.atd": "(* JSON support only *)\n\ntype json <ocaml module=\"Yojson.Safe\" t=\"t\"> = abstract\ntype dyn <ocaml module=\"Yojson.Safe\" t=\"t\"> = abstract\n\ntype t = {\n  foo: int;\n  bar: json;\n  baz: dyn\n}\n\ntype unixtime_list = int <ocaml repr=\"float\"> list\n\ntype patch = {\n  ?patch1: int nullable option;\n  ?patch2: int nullable option;\n  ?patch3: int nullable option;\n} <json keep_nulls>\n\n(*** Test json adapters ***)\n\n(*\n   The real json representation uses an object with a `\"type\"` field\n   equal to `\"a\"` or `\"b\"`. Types `a` and `b` are incompatible\n   with one another.\n\n   See normalize/restore functions in `adapter.ml`.\n*)\ntype adapted = [\n  | A <json name=\"a\"> of a\n  | B <json name=\"b\"> of b\n] <json adapter.ocaml=\"Atdgen_runtime.Json_adapter.Type_field\">\n\n(* same as above, but defined using the pair of functions *)\ntype adapted_f = [\n  | FA <json name=\"fa\"> of a\n  | FB <json name=\"fb\"> of b\n] <json adapter.to_ocaml=\"Atdgen_runtime.Json_adapter.normalize_type_field \\\"type\\\"\"\n        adapter.from_ocaml=\"Atdgen_runtime.Json_adapter.restore_type_field \\\"type\\\"\">\n\ntype a = {\n  thing: string;\n  other_thing: bool;\n}\n\ntype b = {\n  thing: int; (* field name found in `a` with another type! *)\n}\n\n(* Json adapters on recursive types *)\n\ntype rec_type = {\n  more: rec_type list;\n} <json adapter.ocaml=\"Json_adapters.Identity\">\n\n(*\n   Test variants represented as single-field json objects.\n*)\ntype sf_adapted = [\n  | A <json name=\"a\"> of bool\n  | B <json name=\"b\"> of int\n] <json adapter.ocaml=\"Atdgen_runtime.Json_adapter.One_field\">\n\n(*\n   Test substitute for the retired tag_field feature.\n*)\n\ntype tf_variant = [\n  | A <json name=\"a\"> of int\n  | B <json name=\"b\"> of int\n]\n\n(*\n   Sample raw json: { \"the_type\": \"a\", \"the_value\": 123, \"etc\": \"blah\" }\n   Sample normalized json: { \"the_value\": [\"a\", 123], \"etc\": \"blah\" }\n   Test_lib.Tag_field_example takes care of the conversion\n   between the two forms.\n*)\ntype tf_record = {\n  the_value : tf_variant;\n  etc : string;\n} <json adapter.ocaml=\"Test_lib.Tag_field_example\">\n\ntype tf_variant2 = [\n  | A <json name=\"a\"> of int\n  | B <json name=\"b\"> of int\n  | Unknown of (string * json nullable)\n]\n\ntype tf_record2 = {\n  the_value2 : tf_variant2;\n  etc2 : string;\n} <json adapter.ocaml=\"Test_lib.Tag_field_with_catchall\">\n\n(*\n   Test open_enum feature.\n*)\ntype sample_open_enum = [\n  | Alpha\n  | Beta\n  | Other of string\n] <json open_enum>\n\ntype sample_open_enums = sample_open_enum list\n",
  "atdgen/test/test5.atd": "(* Basic testing of -allow-name-overlap *)\n\ntype ab1 = {\n  a : string;\n  b : int;\n}\n\ntype ab2 = {\n  a : string;\n  b : int;\n}\n\ntype bca = {\n  b : ab2 list;\n  c : int list;\n  a : float;\n}\n\ntype cd1 = [\n  | C of int\n  | D of string\n] <ocaml repr=\"classic\">\n\ntype cd2 = [\n  | C of float\n  | D of bool\n] <ocaml repr=\"classic\">\n\ntype cde = [\n  | C of int\n  | D of cd1\n  | E of cd2\n]\n\ntype all = {\n  a : ab1;\n  b : ab2;\n  c : bca list;\n  d : cde list;\n}\n\ntype contains_variant = {\n  foo : string;\n  bar : [ One | Two | Three of int ]\n}\n",
  "atdgen/test/test_abstract.atd": "\ntype 'x abs1 <ocaml_biniou module=\"Test\">\n             <ocaml_json module=\"Testj\"> = abstract\n\ntype 'x abs2 <ocaml module=\"Test\">\n             <ocaml_json module=\"Testj\"> = abstract\n\n(* import an external type *)\ntype int_assoc_list <ocaml module=\"Testj\"> = abstract\n\n(* untyped JSON.\n\n   'abstract' translates to the 'Yojson.Safe.t' type even for the biniou\n   backend since it shares type definitions with the JSON backend.\n *)\ntype any = abstract\ntype any_items = abstract list\n",
  "atdgen/test/test_ambiguous_record.atd": "type ambiguous = {ambiguous:string;not_ambiguous1:int}\n\ntype ambiguous' = {ambiguous:string;not_ambiguous2:int}\n   <json adapter.ocaml=\"Json_adapters.Identity\">\n\n",
  "atdgen/test/test_ambiguous_variant.atd": "type ambiguous = [\n  | Int of int\n  | String of string\n]\n  <json adapter.ocaml=\"Json_adapters.Identity\">\n<ocaml repr=\"classic\">\n\ntype ambiguous' = [\n  | Int of int\n  | String of string\n]\n  <json adapter.ocaml=\"Json_adapters.Identity\">\n<ocaml repr=\"classic\">\n",
  "atdgen/test/test_annot.atd": "type pointA <ocaml from=\"ProtoA\"> <ocaml predef> = {\n  f: float\n}\n\ntype pointB <ocaml_json predef><ocaml from=\"ProtoB\"><ocaml_json from=\"ProtoD\"><ocaml_biniou predef> = {\n  f: float\n}\n\ntype pointC <ocaml_biniou from=\"ProtoE\"><ocaml from=\"ProtoC\" predef> = {\n  f: float\n}\n",
  "atdgen/test/test_annot_error.atd": "type pointA <ocaml from=\"ProtoA\"> <ocaml predef from=\"ProtoB\"> <ocaml from=\"ProtoC\" from=\"ProtoB\">= {\n  f: float\n}\n",
  "atdgen/test/test_classic_inline_record.atd": "type foo = [ Foo of {x: int; y: float} ]<ocaml repr=\"classic\">\n",
  "atdgen/test/test_int.atd": "type char = int <ocaml repr=\"char\"> (* json repr should default to the same type as atd (int) *)\ntype int32 = int <ocaml repr=\"int32\"> <json repr=\"int\">\ntype int64 = int <ocaml repr=\"int64\"> <json repr=\"int\">\ntype afloat = int <ocaml repr=\"float\"> <json repr=\"int\">\n",
  "atdgen/test/test_int_with_string_repr.atd": "type char = int <ocaml repr=\"char\"> <json repr=\"string\">\ntype int32 = int <ocaml repr=\"int32\"> <json repr=\"string\">\ntype int64 = int <ocaml repr=\"int64\"> <json repr=\"string\">\ntype afloat = int <ocaml repr=\"float\"> <json repr=\"string\">\n",
  "atdgen/test/test_ocaml_keyword_error1.atd": "type then = int\n",
  "atdgen/test/test_ocaml_keyword_error2.atd": "type t = {\n  if : int;\n}\n",
  "atdgen/test/test_poly_inline_record_error.atd": "type foo = [ Foo of {x: int} ]\n",
  "atdgen/test/test_polymorphic_wrap.atd": "type 'a t = 'a list wrap <ocaml module=\"Array_wrap\">\n",
  "atdgen/test/test_ppx.atd": "type t <ocaml attr=\"deriving show,eq\" attr=\"ocamlformat \\\"disable\\\"\"> = {\n  v: int;\n}\n",
  "atdgen/test/test_unit_biniou.atd": "type t = unit\n",
  "atdj/test/test.atd": "(* Sum (enum) *)\ntype e = [ Alpha | Beta ]\n\n(* Sum *)\ntype sample_sum = [\n  | Simple_tag\n  | Bool of bool\n  | Int of int\n  | Float of float\n  | String <java name=\"S\"> of string\n  | Simple_record of simple_record\n  | Complex_record of complex_record\n  | Record_with_defaults of record_with_defaults\n]\n\n(* Record *)\ntype complex_record = {\n  b <doc text=\"foo bar baz\"> : bool;\n  i : int;\n  s : string;\n  l : bool list;\n  sample_sum : sample_sum;\n\n  (* Java keywords used as field names *)\n  ?class : int option;\n  ?final <java name=\"is_final\"> : int option;\n\n  (* List of records *)\n  l2 : record_with_defaults list;\n}\n\n<doc text=\"wibble\">\n\n(* Record with default fields *)\ntype record_with_defaults = {\n  ~b : bool;\n  ~i : int;\n  ~s : string;\n  ~o : bool option;\n  ~l : bool list;\n  ~e : e;\n}\n\n(* Record with optional field *)\ntype simple_record = { ?o : bool option }\n\n(* https://github.com/esperco/atdj/issues/2 *)\ntype a = [ A of b list ]\ntype b = [ B ]\n\n(* Type alias for a list - Java doesn't support type aliases, so we generate\n   a wrapper class with the same JSON interface as record classes. *)\ntype items = simple_record list\n\n(*\n  Sum type using the object encoding: {\"Constructor\": payload}\n  instead of the default array encoding: [\"Constructor\", payload].\n\n  This matches the Rust/Serde default (externally-tagged) and also\n  looks natural in YAML:\n\n    # array encoding (default):\n    - - Circle\n      - 3.14\n    # object encoding (<json repr=\"object\">):\n    - Circle: 3.14\n*)\ntype shape = [\n  | Circle of float\n  | Square of float\n  | Point              (* unit variant -- always encoded as a plain string *)\n] <json repr=\"object\">\n",
  "atdpy/test/atd-input/ALLCAPS.atd": "",
  "atdpy/test/atd-input/def_.atd": "type tag = string\ntype priority = int\n",
  "atdpy/test/atd-input/everything.atd": "<python text=\"# This was inserted by the user.\">\n<python json_py.text=\"import deco\">\n<python json_py.text=\"from dataclasses import dataclass\">\n<doc text=\"User-inserted doc\">\n\nfrom def <python name=\"def_\"> as class import priority\nfrom if <python name=\"if_\"> import tag\n\ntype kind <doc text=\"Definition-level doc\"> = [\n  | Root (* class name conflict *)\n  | Thing\n      <doc text=\"\n    Case-level doc. First paragraph explaining {{Thing}}.\n\n    Second paragraph.\n{{{\n  Preformatted block.\n    Second line with extra indentation.\n}}}\n    End.\n\">\n    of int\n  | WOW <json name=\"wow\">\n  | Amaze <json name=\"!!!\"> of string list\n] <doc text=\"Sum-level doc\">\n\ntype frozen\n  <python decorator=\"dataclass(frozen=True)\"> = [\n  | A\n  | B of int\n]\n\ntype ('a, 'b) parametrized_record = {\n  field_a: 'a;\n  ~field_b: 'b list;\n}\n\ntype 'a parametrized_tuple = ('a * 'a * int)\n\ntype root <doc text=\"Definition-level doc.\"> = {\n  id <json name=\"ID\">: string;\n  await: bool;\n  __init__: float;\n  items: int list list;\n  ?maybe: int option;\n  ~extras: int list;\n  ~answer <python default=\"42\">: int;\n  aliased: alias;\n  point: (float * float);\n  kinds: kind list;\n  assoc1: (float * int) list;\n  assoc2: (string * int) list <json repr=\"object\">;\n  assoc3: (float * int) list <python repr=\"dict\">;\n  assoc4: (string * int) list <json repr=\"object\"> <python repr=\"dict\">;\n  nullables: int nullable list;\n  options: int option list;\n  untyped_things: abstract list;\n  parametrized_record: (int, float) parametrized_record;\n  parametrized_tuple: kind parametrized_tuple;\n  num <doc text=\"\n    First paragraph explaining {{num}}. This paragraph\n    should be\n       nicely\n    rewrapped into multiple lines of even length.\n    A super long URL such as https://example.com/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx should end up on its\n    own line.\n\n    Second paragraph.\n{{{\n  Preformatted block.\n    Second line with extra indentation.\n}}}\n    End.\n\">: int;\n  num2 <doc text=\"Another field.\">: int;\n}\n  <doc text=\"Record-level doc. This is a comment on the {{root}} type.\n\n     This is a second paragraph and here's a preformatted block:\n{{{\nfirst line of the preformatted block\n  second line with extra indentation\n}}}\n     Escape these: \\\"\\\"\\\" and '''\n\">\n\ntype alias = int list\n\n(* Test for <json repr=\"object\"> on sum types.\n   Tagged variants are encoded as single-key JSON objects {\"Constructor\": payload}\n   instead of the default two-element array [\"Constructor\", payload].\n   This matches the default Rust/Serde externally-tagged encoding and\n   also maps naturally to YAML (each variant is a single-key mapping). *)\ntype shape = [\n  | Circle of float  (* radius *)\n  | Square of float  (* side length *)\n  | Point            (* unit variant -- still encoded as a plain string *)\n] <json repr=\"object\">\n\ntype pair <doc text=\"Def-level doc\"> =\n  (string * int) <doc text=\"Type-level doc\">\n\ntype require_field <python decorator=\"deco.deco1\"\n                           decorator=\"deco.deco2(42)\"\n                           decorator=\"dataclass(order=True)\"> = {\n  req: string;\n}\n\ntype recursive_class = {\n  id: int;\n  flag: bool;\n  children: recursive_class list;\n}\n\ntype default_list = {\n  ~items: int list;\n}\n\ntype tagged = {\n  ext_tag: if.tag;\n  priority: class.priority;\n}\n",
  "atdpy/test/atd-input/if_.atd": "type tag = string\ntype priority = int\n",
  "atds/test/test.atd": "(* Sum (enum) *)\ntype e = [ Alpha | Beta ]\n\ntype es = e list\n\n(* Record with optional field *)\ntype simple_record = {\n  int_field: int;\n  ?opt : bool option\n}\n\n\n(* Sum *)\ntype sample_sum = [\n  | Simple_tag\n  | Bool of bool\n  | Int <scala name=\"Integer\"> of int\n  | Float of float\n  | String <scala name=\"S\"> of string\n  | Simple_rec of simple_record\n  | Complex_record of complex_record\n  | Record_with_defaults of record_with_defaults\n]\n\n\n(* Record *)\ntype complex_record = {\n  b <doc text=\"foo bar baz\"> : bool;\n  i : int;\n  s : string;\n  l : bool list;\n  m : int list list;\n  sample_sum : sample_sum;\n\n  (* Scala keywords used as field names *)\n  ?class : int option;\n  ?final <java name=\"is_final\"> : int option;\n  case <scala name=\"kase\"> : string;\n\n  (* List of records *)\n  l2 : record_with_defaults list;\n}\n<doc text=\"wibble\">\n\n(* Record with default fields *)\ntype record_with_defaults = {\n  ~b : bool;\n  ~i : int;\n  ~s : string;\n  ~o : bool option;\n  ~l : bool list;\n  ~e : e;\n  }\n\ntype bigger_record = {\n  inherit record_with_defaults;\n  more : string;\n}\n\n(* type alias *)\ntype rec = record_with_defaults\ntype rwd <scala name=\"RWD\"> = record_with_defaults\n\ntype bigger_sum = [\n  inherit e\n  | Gamma\n]\n\ntype street = (int * string)\ntype city = string\ntype state = string\n\ntype addr = {\n  street: street;\n  city: city;\n  state: state;\n}\n\n(*\n(* https://github.com/esperco/atdj/issues/2 *)\ntype a = [ A of b list ]\ntype b = [ B ]\n*)\n\n(*\n  Sum type using the object encoding: {\"Constructor\": payload}\n  instead of the default array encoding: [\"Constructor\", payload].\n\n  This matches the Rust/Serde default (externally-tagged) and also\n  looks natural in YAML:\n\n    # array encoding (default):\n    - - Circle\n      - 3.14\n    # object encoding (<json repr=\"object\">):\n    - Circle: 3.14\n*)\ntype shape = [\n  | Circle of float\n  | Square of float\n  | Point              (* unit variant -- always encoded as a plain string *)\n] <json repr=\"object\">\n",
  "atdts/test/gen-expect-tests/dotted_import.atd": "from long.module.path import tag\n\n(* The local name of the imported module is \"path\" (the last component).\n   In the TypeScript output, it is imported from \"./long/module/path\". *)\ntype foo = {\n  tag: path.tag;\n}\n",
  "atdts/test/gen-expect-tests/everything.atd": "(*\n   ATD type definitions for testing their translation to TypeScript.\n*)\n\nfrom ext_types import tag\n\n(* Testing raw JSON. Should map to type 'any'. *)\ntype anything = abstract\n\ntype different_kinds_of_things = [\n  | Root (* class name conflict *)\n  | Thing of int\n  | WOW <json name=\"wow\">\n  | Amaze <json name=\"!!!\"> of string list\n]\n\n(* TS keyword *)\ntype this = int\n\ntype ('a, 'b) parametrized_record = {\n  field_a: 'a;\n  ~field_b: 'b list;\n}\n\ntype 'a parametrized_tuple = ('a * 'a * int)\n\ntype simple_record = {\n  str: string;\n}\n\ntype root = {\n  id <json name=\"ID\">: string;\n  this: this;\n  items: int list list;\n  ?maybe: int option;\n  ?maybe2: simple_record option;\n  ~extras: int list;\n  ~answer <ts default=\"42\">: int;\n  aliased: alias;\n  point: (float * float);\n  kinds: different_kinds_of_things list;\n  assoc1: (float * int) list;\n  assoc2: (string * int) list <json repr=\"object\">;\n  assoc3: (float * int) list <ts repr=\"map\">;\n  assoc4: (string * int) list <json repr=\"object\"> <ts repr=\"map\">;\n  ~options: int option list;\n  ~nullables: int nullable list;\n  untyped_things: abstract list;\n  foo: foo nullable;\n  parametrized_record: (int, float) parametrized_record;\n  parametrized_tuple: different_kinds_of_things parametrized_tuple;\n  anything: anything;\n  wrapped: string wrap list;\n  ext_tag: ext_types.tag;\n}\n\ntype alias = int list\n\n(* Test for <json repr=\"object\"> on sum types.\n   Tagged variants are encoded as single-key JSON objects {\"Constructor\": payload}\n   instead of the default two-element array [\"Constructor\", payload].\n   This matches the default Rust/Serde externally-tagged encoding and\n   also maps naturally to YAML (each variant is a single-key mapping). *)\ntype shape = [\n  | Circle of float  (* radius *)\n  | Square of float  (* side length *)\n  | Point            (* unit variant -- still encoded as a plain string *)\n] <json repr=\"object\">\n\ntype pair = (string * int)\n\ntype foo = {\n  foo: string;\n}\n\ntype special_string = string wrap\n\ntype import_default <ts from=\"Import\"> = abstract\ntype import_ <ts from=\"Import\" t=\"import\"> = abstract\n",
  "atdts/test/gen-expect-tests/ext_types.atd": "type tag = string\ntype priority = int\n",
  "atdts/test/gen-expect-tests/import.atd": "type import_default = bool\ntype import_ = string\n",
  "atdts/test/gen-expect-tests/import_alias.atd": "from ext_types <ts name=\"etypes\"> import tag\n\ntype item = {\n  tag: ext_types.tag;\n}\n",
  "doc/atdgen-tutorial-data/config-file/config.atd": "type config = {\n  title : string;\n  ?description : string option;\n  ~timeout <ocaml default=\"10\"> : int;\n  ~credentials : param list\n    <ocaml valid=\"fun l ->\n                    l <> [] || failwith \\\"missing credentials\\\"\">;\n}\n\ntype param = {\n  name : string\n    <ocaml valid=\"fun s -> s <> \\\"\\\"\">;\n  key : string\n    <ocaml valid=\"fun s -> String.length s = 16\">;\n}\n",
  "doc/atdgen-tutorial-data/hello/hello.atd": "type date = {\n  year : int;\n  month : int;\n  day : int;\n}\n",
  "doc/atdgen-tutorial-data/inspect-biniou/tree.atd": "(* This a binary tree. Just for the purpose of pretty-printing trees. *)\ntype tree =\n    [ Empty\n    | Node of (tree * int * tree) ]\n\n",
  "doc/atdgen-tutorial-data/modularity/part1.atd": "type t = { x : int; y : int }\n",
  "doc/atdgen-tutorial-data/modularity/part2.atd": "type t1 <ocaml from=\"Part1\" t=\"t\"> = abstract\n    (*\n      Imports type t defined in file part1.atd.\n      The local name is t1. Because the local name (t1) is different from the\n      original name (t), we must specify the original name using t=.\n    *)\n\ntype t2 = t1 list\n",
  "doc/atdgen-tutorial-data/modularity/part3.atd": "type t2 <ocaml from=\"Part2\"> = abstract\n\ntype t3 = {\n  name : string;\n  ?data : t2 option;\n}\n",
  "doc/atdgen-tutorial-data/untypable-json/untypable.atd": "(* File untypable.atd *)\n\ntype obj_list = obj list\n\ntype obj = {\n  ?label: string option;\n  ?labels: string list option;\n  value: abstract  (* requires ATD >= 2.6.0 *)\n}\n",
  "doc/atdgen-tutorial-data/untypable-json/untypable_v1.atd": "(* File untypable.atd *)\n\n(* deprecated since ATD 2.6 *)\ntype json <ocaml module=\"Yojson.Safe\"> = abstract\n  (* uses type Yojson.Safe.t,\n     with the functions Yojson.Safe.write_json\n     and Yojson.Safe.read_json *)\n\ntype obj_list = obj list\n\ntype obj = {\n  ?label: string option;\n  ?labels: string list option;\n  value: json\n}\n",
  "doc/atdgen-tutorial-data/untypable-json/untypable_v2.atd": "(* deprecated since ATD 2.6 *)\ntype raw_json <ocaml module=\"Yojson.Safe\" t=\"json\"> = abstract\n  (* uses type Yojson.Safe.t,\n     with the functions Yojson.Safe.write_json\n     and Yojson.Safe.read_json *)\n\ntype obj_list = obj list\n\ntype obj = {\n  ?label: string option;\n  ?labels: string list option;\n  value: raw_json\n}\n",
  "doc/atdgen-tutorial-data/untypable-json/untypable_v3.atd": "(* File untypable.atd *)\n\ntype obj_list = obj list\n\ntype obj = {\n  ?label: string option;\n  ?labels: string list option;\n  value: abstract  (* requires ATD >= 2.6.0 *)\n}\n",
  "doc/atdgen-tutorial-data/validate/resume.atd": "type text = string <ocaml valid=\"Resume_util.validate_some_text\">\n\ntype date = {\n  year : int;\n  month : int;\n  day : int;\n} <ocaml valid=\"Resume_util.validate_date\">\n\ntype job = {\n  company : text;\n  title : text;\n  start_date : date;\n  ?end_date : date option;\n} <ocaml valid=\"Resume_util.validate_job\">\n\ntype work_experience = job list\n",
}

///|
test "upstream 0: atdcat atd-yamlx/examples/app_config.atd" {
  check_atdcat(
    upstream_inputs,
    ["atd-yamlx/examples/app_config.atd"],
    stdin="",
    stdout="type log_level = [ Debug | Info | Warn | Error ] <json repr=\"object\">\ntype db_backend =\n  [ Sqlite of string | Postgres of pg_config ] <json repr=\"object\">\ntype pg_config = { host: string; port: int; dbname: string; ~ssl: bool }\ntype app_config = {\n  ~name: string;\n  log_level: log_level;\n  db: db_backend;\n  ~tags: string list\n}\n",
    stderr="",
    code=0,
  )
}

///|
test "upstream 1: atdcat -x -i atd-yamlx/examples/app_config.atd" {
  check_atdcat(
    upstream_inputs,
    ["-x", "-i", "atd-yamlx/examples/app_config.atd"],
    stdin="",
