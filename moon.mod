name = "bobzhang/atd"

version = "0.2.0"

readme = "README.md"

repository = "https://github.com/bobzhang/atd.mbt"

license = "BSD-3-Clause"

keywords = [ "atd", "json", "codegen", "types" ]

description = "A MoonBit port of ATD (Adaptable Type Definitions) with a MoonBit code generator"

import {
  "moonbitlang/x@0.5.5",
  "moonbitlang/async@0.22.4",
  "bobzhang/format@0.1.1",
  "bobzhang/easy_format@0.1.0",
  "bobzhang/atd_runtime@0.1.0",
}

source = "src"
