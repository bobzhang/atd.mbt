///|
// Regenerate the MoonBit code of the test fixtures (src/tests/*/*.atd)
// with atdmbt, then format it.
//
// Usage, from the root of the repository:
//
//   moonx scripts/regen_fixtures.mbtx

import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/process",
  "moonbitlang/async@0.22.4/stdio",
}

///|
async fn check(cmd : String, args : Array[String], cwd? : String = ".") -> Unit {
  let code = @process.run(cmd, args, cwd~)
  if code != 0 {
    raise Failure("command failed: \{cmd} \{args.join(" ")}")
  }
}

///|
async fn main {
  check("moon", ["build", "--target", "native", "src/cmd/atdmbt"])
  let atdmbt = @fs.realpath(
    "_build/native/debug/build/bobzhang/atd/cmd/atdmbt/atdmbt.exe",
  )
  for dir in @fs.readdir("src/tests", sort=true) {
    let dir = "src/tests/" + dir
    if @fs.kind(dir) is Directory {
      for name in @fs.readdir(dir, sort=true) {
        if name.has_suffix(".atd") {
          @stdio.stdout.write("\{dir}/\{name}\n")
          check(atdmbt, [name], cwd=dir)
        }
      }
    }
  }
  check("moon", ["fmt"])
}
