///|
// Generate MoonBit tests checking that the MoonBit atdcat produces the same
// output as the reference OCaml atdcat.
//
// Usage, from the root of the repository:
//
//   moonx scripts/gen_compat_tests.mbtx <path to reference atdcat.exe>
//   moon fmt
//
// The upstream ATD sources are expected in .repos/atd (see README.md).
// The generated test files are written to src/atdcat/.

import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/process",
  "moonbitlang/async@0.22.4/stdio",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
}

///|
let upstream : String = ".repos/atd"

///|
let errors_dir : String = "tests/errors"

///|
let out_dir : String = "src/atdcat"

///|
/// Inputs that trigger known, intentional deviations from upstream:
/// - e060: upstream crashes with Invalid_argument("byte_of_dec")
/// - e080: upstream crashes with Invalid_argument("Type_name.split ...")
/// - e098: invalid UTF-8 in a string literal; MoonBit strings are Unicode
let skip : Array[String] = ["e060.atd", "e080.atd", "e098.atd"]

///|
let full_options : Array[Array[String]] = [
  [],
  ["-x"],
  ["-xk"],
  ["-xd"],
  ["-i"],
  ["-if"],
  ["-iv"],
  ["-remove-wraps"],
  ["-strip-all"],
  ["-strip", "json,doc"],
  ["-html-doc"],
  ["-ml", "foo"],
  ["-jsonschema", "root"],
  ["-jsonschema", "root", "-jsonschema-version", "draft-2019-09"],
  ["-jsonschema", "root", "-jsonschema-no-additional-properties"],
]

///|
let basic_options : Array[Array[String]] = [[], ["-x", "-i"]]

///|
/// A MoonBit string literal.
fn mbt_string(s : String) -> String {
  let buf = StringBuilder()
  buf.write_char('"')
  for c in s {
    match c {
      '"' => buf.write_string("\\\"")
      '\\' => buf.write_string("\\\\")
      '\n' => buf.write_string("\\n")
      '\r' => buf.write_string("\\r")
      '\t' => buf.write_string("\\t")
      c if c.to_int() < 0x20 || c.to_int() == 0x7F => {
        let hex = "0123456789abcdef"
        let n = c.to_int()
        buf.write_string("\\u{")
        if n >= 16 {
          buf.write_char(hex[n >> 4].unsafe_to_char())
        }
        buf.write_char(hex[n & 0xF].unsafe_to_char())
        buf.write_string("}")
      }
      c => buf.write_char(c)
    }
  }
  buf.write_char('"')
  buf.to_string()
}

///|
/// Compare strings by code points, like Python.
fn compare_paths(a : String, b : String) -> Int {
  let ia = a.iter()
  let ib = b.iter()
  for ;; {
    match (ia.next(), ib.next()) {
      (None, None) => break 0
      (None, Some(_)) => break -1
      (Some(_), None) => break 1
      (Some(x), Some(y)) => if x != y { break x.to_int().compare(y.to_int()) }
    }
  }
}

///|
/// All the `.atd` files under a directory, relative to it, sorted.
async fn find_atd_files(root : String) -> Array[String] {
  let res = []
  async fn walk(rel : String) -> Unit {
    let dir = if rel == "" { root } else { root + "/" + rel }
    for name in @fs.readdir(dir, sort=true) {
      let rel_path = if rel == "" { name } else { rel + "/" + name }
      match @fs.kind(root + "/" + rel_path) {
        Directory => walk(rel_path)
        Regular => if name.has_suffix(".atd") { res.push(rel_path) }
        _ => ()
      }
    }
  }

  walk("")
  res.sort_by(compare_paths)
  res
}

///|
struct Case {
  args : Array[String]
  stdin_file : String?
  stdout : String
  stderr : String
  code : Int
}

///|
async fn run_reference(
  reference : String,
  cwd : String,
  args : Array[String],
  stdin_file? : String,
) -> Case {
  let (code, out, err) = match stdin_file {
    None => @process.collect_output(reference, args, cwd~)
    Some(f) =>
      @process.collect_output(
        reference,
        args,
        cwd~,
        stdin=@process.redirect_from_file(cwd + "/" + f),
      )
  }
  // the program name appears in usage messages
  let program_name = (s : String) => s.replace_all(old=reference, new="atdcat")
  {
    args,
    stdin_file,
    stdout: program_name(out.text()),
    stderr: program_name(err.text()),
    code,
  }
}

///|
fn valid_utf8(b : Bytes) -> String? {
  try @utf8.decode(b) catch {
    _ => None
  } noraise {
    s => Some(s)
  }
}

///|
async fn generate(
  name : String,
  cases : Array[Case],
  inputs : Array[(String, String)],
) -> Unit {
  let lines = [
    "// Generated by scripts/gen_compat_tests.mbtx. DO NOT EDIT.",
    "// Expected outputs were produced by the reference OCaml atdcat.",
    "",
    "///|",
    "let \{name}_inputs : Map[String, String] = {",
  ]
  for input in inputs {
    lines.push("  \{mbt_string(input.0)}: \{mbt_string(input.1)},")
  }
  lines.push("}")
  lines.push("")
  for i, c in cases {
    let mut title = "\{name} \{i}: atdcat \{c.args.join(" ")}"
    if c.stdin_file is Some(f) {
      title = title + " < " + f
    }
    lines.push("///|")
    lines.push("test \{mbt_string(title)} {")
    lines.push("  check_atdcat(")
    lines.push("    \{name}_inputs,")
    lines.push("    [\{c.args.map(mbt_string).join(", ")}],")
    lines.push("    stdin=\{mbt_string(c.stdin_file.unwrap_or(""))},")
    lines.push("    stdout=\{mbt_string(c.stdout)},")
    lines.push("    stderr=\{mbt_string(c.stderr)},")
    lines.push("    code=\{c.code},")
    lines.push("  )")
    lines.push("}")
    lines.push("")
  }
  let path = "\{out_dir}/compat_\{name}_test.mbt"
  @fs.write_file(path, lines.join("\n"))
  @stdio.stdout.write("wrote \{path} (\{cases.length()} cases)\n")
}

///|
async fn main {
  let args = @env.args()
  if args.length() < 2 {
    @stdio.stderr.write(
      "usage: moonx scripts/gen_compat_tests.mbtx <reference atdcat.exe>\n",
    )
    raise Failure("missing argument")
  }
  let reference = args[1]
  // Upstream test inputs, with all the options
  let inputs = []
  let cases = []
  for rel in find_atd_files(upstream) {
    guard valid_utf8(@fs.read_file(upstream + "/" + rel).binary())
      is Some(content) else {
      continue
    }
    inputs.push((rel, content))
    let options = if rel.has_prefix("atdcat/") {
      full_options
    } else {
      basic_options
    }
    for opts in options {
      cases.push(run_reference(reference, upstream, [..opts, rel]))
    }
  }
  // reading from stdin
  cases.push(
    run_reference(
      reference,
      upstream,
      [],
      stdin_file="atdcat/tests/input/test2.atd",
    ),
  )
  // multiple files (processed in reverse order, like upstream)
  cases.push(
    run_reference(reference, upstream, [
      "atdcat/tests/input/test2.atd", "atdcat/tests/input/schema.atd",
    ]),
  )
  // command-line usage
  for args in [["-help"], ["--help"], ["-bogus"], ["-o"]] {
    cases.push(run_reference(reference, upstream, args))
  }
  generate("upstream", cases, inputs)

  // Malformed inputs
  let inputs = []
  let cases = []
  let names = @fs.readdir(errors_dir, sort=true).filter(n => {
    n.has_suffix(".atd")
  })
  names.sort_by(compare_paths)
  for name in names {
    if skip.contains(name) {
      continue
    }
    let content = @utf8.decode(@fs.read_file(errors_dir + "/" + name).binary())
    inputs.push((name, content))
    cases.push(run_reference(reference, errors_dir, [name]))
    if content.contains("doc") {
      cases.push(run_reference(reference, errors_dir, ["-html-doc", name]))
    }
  }
  generate("errors", cases, inputs)
}
